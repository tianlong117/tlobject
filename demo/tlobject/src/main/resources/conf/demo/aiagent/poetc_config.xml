<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <!-- ===== poetc 配置（诗歌评判 Agent）=====
         在 poemWorkflow 的 <modules> 中通过 configfile 引用。
         filesystemMcpWrite 作为 LLM 可调用的工具（factoryShared 共享主工厂实例，不重复启动 npx），
         供 poetc 调用 write_file 把分析结果写入文件。
         ⚠ factoryShared 按"模块名"共享主工厂实例：同名多声明时**先初始化者的白名单生效**
         （曾踩：与 fileAgent 的同名 filesystemMcp 撞车——它想要 3 工具却只拿到本组的 write_file，
         故写-only 组改用 filesystemMcpWrite 区分）。
         MCP 允许根固定在 workspace/（沙箱），且 write_file 已在 approvalGate 挂审批。 -->

    <agents>
        <agent name="filesystemMcpWrite"
               statup="true"
               factoryShared="true"
               type="mcp"
               tools="write_file"
               description="MCP文件系统工具集（仅写文件）"
               sameClassAs="mcpAgent"
               transport="stdio"
               command="C:/Program Files/nodejs/npx.cmd"
               args="-y @modelcontextprotocol/server-filesystem workspace"/>
    </agents>
</moduleConfig>
