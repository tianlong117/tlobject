<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <!-- 引入框架核心模块定义 -->
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.modules_config.xml" includeUnit="modules"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.network_config.xml" includeUnit="modules"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.db_config.xml" includeUnit="modules"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.aiagent_config.xml" includeUnit="modules"/>

    <params>
        <!-- 应用标识 -->
        <applicationId value="aiagentDemo"/>

        <!-- 日志配置 -->
        <ifLog value="true"/>
        <loglevel value="DEBUG"/>
        <logWait value="true"/>
        <defaultLogModule value="log4j"/>
        <!-- 模块监控（关闭以提高性能） -->
        <ifModuleMonitor value="false"/>

        <!-- Demo Java包前缀 -->
        <package value="cn.tianlong.java.demo.aiagent"/>
    </params>

    <modulesParams>
        <module name="aiContext" defaultSystemMessage="你是一个有用的AI助手，可以使用工具来帮助用户完成任务。请用简洁清晰的语言回答问题。"/>
    </modulesParams>

    <modules>
        <!-- 主测试模块 -->
        <module name="aiAgentDemo"
                classfile=".AiAgentDemoModule"
                configfile="CLASSPATH/conf/demo/aiagent/aiagent_demo_config.xml"
                singleton="true"/>

        <!-- DAG工作流模块 -->
        <module name="demoWorkflow"
                classfile="cn.tianlong.tlobject.aiagent.workflow.TLAgentWorkflow"
                configfile="CLASSPATH/conf/demo/aiagent/demoWorkflow_config.xml"/>

    </modules>

    <!-- ===== 工厂启动序列 ===== -->
    <factoryBoot>
        <!-- 先获取日志模块 -->
        <msg action="getModule" destination="moduleFactory" moduleName="logThreadPool"/>

        <!-- 获取AI Agent核心模块（触发初始化） -->
        <msg action="getModule" destination="moduleFactory" moduleName="aiagent"/>
        <msg action="getModule" destination="moduleFactory" moduleName="aiContext"/>

        <!-- 获取内置模块 -->
        <msg action="getModule" destination="moduleFactory" moduleName="openAiProvider"/>
        <msg action="getModule" destination="moduleFactory" moduleName="httpRequestSkill"/>
        <msg action="getModule" destination="moduleFactory" moduleName="fileOperationSkill"/>
        <msg action="getModule" destination="moduleFactory" moduleName="shortTermMemory"/>
        <msg action="getModule" destination="moduleFactory" moduleName="longTermMemory"/>

        <!-- 获取Demo测试模块和工作流模块 -->
        <msg action="getModule" destination="moduleFactory" moduleName="aiAgentDemo"/>
        <msg action="getModule" destination="moduleFactory" moduleName="demoWorkflow"/>
        <msg action="getModule" destination="moduleFactory" moduleName="agentMonitor"/>
        <msg action="getModule" destination="moduleFactory" moduleName="streamCallback"/>

        <!-- 获取监管Agent -->
        <msg action="getModule" destination="moduleFactory" moduleName="errorSupervisor"/>

        <!-- 获取审批模块（可选，启用审批时解注） -->
        <!-- <msg action="getModule" destination="moduleFactory" moduleName="approvalGate"/> -->

        <!-- 获取评测模块 -->
        <msg action="getModule" destination="moduleFactory" moduleName="evals"/>
    </factoryBoot>
</moduleConfig>
