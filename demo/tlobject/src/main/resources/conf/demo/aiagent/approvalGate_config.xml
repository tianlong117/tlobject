<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <!-- ===== HITL 人工审批模块配置 =====
         此模块为全局单例，所有 Agent 共享同一套审批规则。
         启用方式：共享工具执行器自身配置（toolExecutor_config.xml 的 approvalModule=approvalGate），
         全应用统一启用；规则按工具名匹配——危险工具（code_execution/script_execution）只在子 agent
         上，天然审批下沉，master 打不中规则不受影响。
         会话/用户隔离由审批请求消息携带的 sessionId/userId 保证（拒绝记忆按会话键）。

         规则为结构化 &lt;rules&gt; 段（见下方），操作名提取逻辑（见 TLApprovalModule.extractOperation）:
           priceTeam      → rule="*"（任意操作都命中）
           code_execution / script_execution → 无操作参数，命中即审批
         路径类工具不再配动作级规则：
           file_operation / word → workspace/{userId} 内免审，越界访问由执行器的 path_access
                                  动态审批覆盖（forceApproval，不依赖规则名），跨用户由路径守卫硬拒绝；
           MCP write_file        → 由 TLMcpAgent.userWorkspaceScoped 处理（跨用户/根外路径在转发前
                                  拒绝），不经过执行器的 path_access 审批。
    -->
    <params>
        <!-- 审查人实现类（全限定名）
             ConsoleReviewer: 审批框投递到控制台/webui 后由 latch 阻塞等待决策（不再读 stdin），
                             决策经 /approve 命令（或 webui 弹框）回传后唤醒
                             命令格式: /approve approve:ID | round:ID | session:ID | reject:ID:原因 -->
        <reviewerClass value="cn.tianlong.tlobject.aiagent.approval.ConsoleReviewer"/>

        <!-- 审查人策略: sync=同步阻塞(控制台), async=异步回调(Web审批) -->
        <reviewerStrategy value="sync"/>

        <!-- 审批超时（毫秒）：0 = 一直等（默认，等待策略改造后语义）。
             有人在收（控制台在跑 / webui SSE 在线）→ 阻塞等，回来批了原线程继续；
             没人收 → 立即转断点，不占线程。断点态兜底看 approvalPendingTtlMs（不会无限期滞留）。 -->
        <approvalTimeoutMs value="0"/>

        <!-- 断点态审批 TTL（毫秒，默认 24h）：仅作用于转为断点的审批——
             用户长时间不回来 → EXPIRED + 消息箱告知；阻塞态不受它影响。0 = 不设 TTL。 -->
        <approvalPendingTtlMs value="86400000"/>
    </params>

    <!-- ===== 审批规则（结构化配置） =====
         name        : 工具名（LLM 函数名）。支持通配：tool:* 冒号风格函数名前缀、tool* 任意前缀
         statup      : true 启用 | false 跳过
         description : 人可读说明（审批弹框中展示）
         action      : 需审批的操作列表（逗号分隔，如 "delete,write"）；不配或 rule="*" = 全部操作 -->
    <rules>
        <!-- ===== 路径策略（2026-11-07）=====
             file_operation / word：workspace/{userId} 内全部免审（含读写删与 word 覆盖动作）；
             越界访问由执行器的 path_access 动态审批覆盖（forceApproval，不依赖规则名）；
             跨用户由路径守卫硬拒绝，不进入审批。
             MCP write_file：由 TLMcpAgent.userWorkspaceScoped 在转发前拦截（跨用户/根外拒绝），
             不经过执行器的 path_access 审批。
             因此这里不再配置 file_operation / word / MCP write_file 的动作级规则。 -->

        <rule name="priceTeam"
              statup="true"
              description="询价/下单需要审批"
              rule="*"/>

        <!-- 任意代码/脚本执行都必须审批：工具层无法事前判断它会读写哪些路径；
             子进程 CWD 已指向 workspace/{userId}，可用“本轮/本会话免审”减少弹框。 -->
        <rule name="code_execution"
              statup="true"
              description="执行代码需要审批"/>
        <rule name="script_execution"
              statup="true"
              description="执行脚本需要审批"/>
    </rules>
</moduleConfig>
