<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <!-- ===== 披萨售卖Agent ===== -->

    <params>
        <defaultLlmProvider value="aiagent_master:openAiProvider"/>
        <maxToolCallIterations value="5"/>
    </params>
    <!--providers>
        <provider name="openAiProvider"
                  sameClassAs="openAiProvider"
                  statup="true"
                  apiKey="sk-your-api-key"
                  apiBaseUrl="https://api.deepseek.com"
                  defaultModel="deepseek-v4-flash"/>
    </providers-->

    <skills>
        <skill name="priceCalc"
               classfile="cn.tianlong.java.demo.aiagent.skills.TLPriceCalculatorSkill"
               statup="true"
               skillName="calculate_price"
               itemName="披萨"
               unitPrice="3"/>
    </skills>

    <agents>
        <agent name="filesystemMcp"
               statup="true"
               factoryShared="true"
               type="mcp"
               tools="write_file"
               sameClassAs="mcpAgent"
               transport="stdio"
               command="C:/Program Files/nodejs/npx.cmd"
               args="-y @modelcontextprotocol/server-filesystem D:/tlobjectapp/tlobject"
               description="MCP文件系统工具集"/>
    </agents>

    <modulesParams>
        <module name="aiContext" defaultSystemMessage="你是一名披萨店店员。披萨3元一个。

当顾客下单时，你必须严格按以下步骤执行，不可跳过任何一步：
1. 使用 calculate_price 工具计算价格
2. 【必须执行】使用 write_file 工具将订单写入 pizza_order.txt，path 固定为 pizza_order.txt，content 格式为 披萨×N=价格元
3. 告知顾客价格

重要：步骤2必须执行，不执行步骤2直接回复是错误的。

用简洁活泼的语气回答。不要使用emoji表情符号。"/>
    </modulesParams>
</moduleConfig>
