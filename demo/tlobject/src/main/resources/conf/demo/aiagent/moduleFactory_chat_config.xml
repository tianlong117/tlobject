<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.modules_config.xml" includeUnit="modules"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.network_config.xml" includeUnit="modules"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.db_config.xml" includeUnit="modules"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.aiagent_config.xml" includeUnit="modules"/>
    <params>
        <applicationId value="chatDemo"/>
        <ifLog value="true"/>
        <logWait value="false" />
        <loglevel value="debug"/>
        <defaultLogModule value="log4j"/>
        <package value="cn.tianlong.java.demo.aiagent"/>
    </params>
    <commonParams>
        <ifLog value="true"/>
        <logWait value="false" />
        <loglevel value="trace"/>
    </commonParams>
    <modulesParams>
        <module name="agentService" agentModule="aiagent_master" sessionManager="dbSessionManager" />
        <module name="chatConsole" agentModule="aiagent_master" sessionManager="dbSessionManager" />
        <module name="aiContext" defaultSystemMessage="你是一个有用的AI助手，可以使用工具来帮助用户完成任务。请用简洁清晰的语言回答问题!。"/>
        <!-- outputGuard 输出护栏规则：amountLimit=金额超限预警；forbiddenTerms=禁止词替换。
             注意：不要加 maxLength 截断规则——护栏作用于最终回复，硬截会丢内容（长诗/长报告被切），
             输出体量已由 contextTokenLimit/发送视图裁剪兜底 -->
        <module name="outputGuard" rules="amountLimit:10000;forbiddenTerms:不要谈论政治"/>
        <module name="appAuthModule"   authModule="auth" userModule="demoUserModule" />
    </modulesParams>
    <modules>
        <!-- 主控Agent（独立模块名，避免递归） -->
        <module name="aiagent_master" sameClassAs="aiagent"  configfile="aiagent_master_config.xml"/>
        <module name="outputGuard" classfile="cn.tianlong.tlobject.aiagent.TLOutputGuard"/>

        <!-- Demo 用户信息模块：XML 配置 userId → role/group -->
        <module name="demoUserModule"
                classfile="cn.tianlong.java.demo.aiagent.DemoUserModule"
                singleton="true"
                users="console_user:guest;admin:member,admin;tianlong:member,guest"
                groups="admin:0" />
        <!-- DAG工作流模块 -->
        <module name="demoWorkflow"
                 sameClassAs="agentWorkflow"
                configfile="demoWorkflow_config.xml"/>
        <module name="myopenAiProvider" sameClassAs="openAiProvider"
                statup="true"
                apiKey="sk-your-api-key"
                apiBaseUrl="https://api.deepseek.com"
                defaultModel="deepseek-v4-flash"
                connTimeOut="30"
                readTimeOut="120"/>
    </modules>
    <factoryBoot>threadPool
        <msg action="getModule" destination="moduleFactory" moduleName="logThreadPool"/>
        <msg action="getModule" destination="moduleFactory" moduleName="threadPool"    usePreReturnMsg="false" />
        <msg action="getModule" destination="moduleFactory" moduleName="database"      usePreReturnMsg="false" />
        <msg action="getModule" destination="moduleFactory" moduleName="dbSessionManager"/>
        <msg action="getModule" destination="moduleFactory" moduleName="myopenAiProvider"/>
        <msg action="getModule" destination="moduleFactory" moduleName="agentService"/>
        <msg action="getModule" destination="moduleFactory" moduleName="chatConsole"/>
        <msg action="getModule" destination="moduleFactory" moduleName="outputGuard" />
        <msg action="getModule" destination="moduleFactory" moduleName="errorSupervisor" />
        <msg action="getModule" destination="moduleFactory" moduleName="approvalGate" />
        <msg action="getModule" destination="moduleFactory" moduleName="appAuthModule"/>
        <msg action="getModule" destination="moduleFactory" moduleName="toolExecutor"/>
        <msg action="getModule" destination="moduleFactory" moduleName="auth"/>
        <msg action="getModule" destination="moduleFactory" moduleName="demoUserModule"/>
        <msg action="getModule" destination="moduleFactory" moduleName="aiagent_master"/>

        <!-- 单元测试模块（/test 命令）：Mock Provider + 辅助 Skill + 测试编排
             测试目标为独立 aiagent 实例（aiagent_config.xml），不影响 aiagent_master 对话 -->
        <msg action="getModule" destination="moduleFactory" moduleName="mockProvider"/>
        <msg action="getModule" destination="moduleFactory" moduleName="testEchoSkill"/>
        <msg action="getModule" destination="moduleFactory" moduleName="testSleepSkill"/>
        <msg action="getModule" destination="moduleFactory" moduleName="agentTestModule"/>
    </factoryBoot>
</moduleConfig>
