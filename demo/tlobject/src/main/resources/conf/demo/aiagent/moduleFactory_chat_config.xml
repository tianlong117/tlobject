<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.modules_config.xml" includeUnit="modules"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.network_config.xml" includeUnit="modules"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.db_config.xml" includeUnit="modules"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.aiagent_config.xml" includeUnit="modules"/>
    <params>
        <applicationId value="chatDemo"/>
        <ifLog value="true"/>
        <logWait value="false" />
        <loglevel value="debug"/>
        <defaultLogModule value="log4j"/>
        <package value="cn.tianlong.java.demo.aiagent"/>
    </params>
    <commonParams>
        <ifLog value="true"/>
        <logWait value="false" />
        <loglevel value="trace"/>
        <controlCenterName value="controlCenter"/>
    </commonParams>
    <modulesParams>
        <module name="agentService" agentModule="aiagent_master" sessionManager="dbSessionManager" />
        <module name="chatConsole" sessionManager="dbSessionManager" userModule="dbUserModule"
                subscribeToolProgress="true" subscribeWorkflowProgress="true" />
        <module name="aiContext" defaultSystemMessage="你是一个有用的AI助手，可以使用工具来帮助用户完成任务。请用简洁清晰的语言回答问题!。"/>
        <!-- outputGuard 输出护栏规则：amountLimit=金额超限预警；forbiddenTerms=禁止词替换。
             注意：不要加 maxLength 截断规则——护栏作用于最终回复，硬截会丢内容（长诗/长报告被切），
             输出体量已由 contextTokenLimit/发送视图裁剪兜底 -->
        <module name="outputGuard" rules="amountLimit:10000;forbiddenTerms:不要谈论政治"/>
        <module name="appAuthModule"   authModule="auth" userModule="dbUserModule" />
    </modulesParams>
    <modules>
        <!-- 工厂级控制中心：core 通用机制 + aiagent 策略子类 -->
        <module name="controlCenter"
                classfile="cn.tianlong.tlobject.aiagent.TLAgentControlCenter"
                singleton="true"
                necessary="yes"
                configfile="controlCenter_config.xml"/>
        <!-- 主控Agent（独立模块名，避免递归） -->
        <module name="aiagent_master" sameClassAs="aiagent"  configfile="aiagent_master_config.xml"/>
        <module name="outputGuard" classfile="cn.tianlong.tlobject.aiagent.TLOutputGuard"/>

        <!-- 数据库用户模块：表为空时用 bootstrapUsers 初始化（含旧配置用户迁移）。
             dongq/xiaoming 是控制台专用种子（空密码，不能登录 Web），供 aistart_dq.bat/aistart_xm.bat 的 -u 使用。
             这里直接写 classfile，不用 sameClassAs="dbUserModule"——注册表与实例同名时，
             include 合并会让实例声明覆盖注册表条目，sameClassAs 解析回自身导致类名为空 -->
        <module name="dbUserModule"
                classfile="cn.tianlong.tlobject.aiagent.user.TLUserModule"
                singleton="true"
                necessary="yes"
                tableName="aiUsers"
                bootstrapUsers="admin:member,admin:123456;tianlong:member,guest:123456;console_user:guest:;dongq:member:;xiaoming:member:"
                bootstrapGroups="admin:0"/>
        <!-- DAG工作流模块 -->
        <module name="demoWorkflow"
                 sameClassAs="agentWorkflow"
                configfile="demoWorkflow_config.xml"/>
        <!-- 定时任务引擎（schedule_task 技能对接；poolSize 决定并发执行的任务数） -->
        <module name="taskScheduler" sameClassAs="msgTask" configfile="taskScheduler_config.xml" singleton="true"/>
        <!-- myopenAiProvider：应用级/评测裁判用的 provider（主对话 provider 在 aiagent_master_config.xml）。
             supportVision：下游为纯文本网关时配 false 跳过图片块（带图会被 400），详见 master 配置同名注释 -->
        <module name="myopenAiProvider" sameClassAs="openAiProvider"
                statup="true"
                apiKey="sk-your-api-key"
                apiBaseUrl="https://api.deepseek.com"
                defaultModel="deepseek-v4-flash"
                connTimeOut="30"
                readTimeOut="120"/>
    </modules>
    <factoryBoot>
        <msg action="getModule" destination="moduleFactory" moduleName="logThreadPool"/>
        <msg action="getModule" destination="moduleFactory" moduleName="threadPool" usePreReturnMsg="false"/>
        <msg action="getModule" destination="moduleFactory" moduleName="database" usePreReturnMsg="false"/>
        <msg action="getModule" destination="moduleFactory" moduleName="controlCenter"/>
    </factoryBoot>
</moduleConfig>
