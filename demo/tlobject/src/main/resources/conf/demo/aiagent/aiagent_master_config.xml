<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <!-- ===== 主控Agent配置示例 ===== -->
    <!-- 有<agents>段 → 自动切换为主控模式 -->
    <!-- 子Agent的"tools" = delegate_to_fileAgent, delegate_to_dbAgent -->

    <params>
        <!-- defaultLlmProvider: 默认LLM Provider模块名 -->
        <defaultLlmProvider value="openAiProvider"/>
        <!-- maxToolCallIterations: LLM tool-call最大迭代轮次 -->
        <maxToolCallIterations value="25"/>
        <!-- defaultTemperature: LLM采样温度 -->
        <defaultTemperature value="0.7"/>
        <!-- defaultMaxTokens: 单次LLM回复最大token数 -->
        <defaultMaxTokens value="4096"/>
        <!-- contextTokenLimit: 发送给 LLM 的上下文 token 预算（默认 1048576 = DeepSeek 1M 上下文）。
             历史按条数裁剪不按体量，超大单条内容（大文件读取/长工具输出/恢复巨量历史）会超模型上下文 → HTTP 400。
             框架按此预算自动丢弃最旧消息、单条仍超则截断后再发送（仅影响当轮发送，不删历史/不影响恢复）。
             模型上下文较小（如 128K）请按实际调小；0 = 关闭自动裁剪。 -->
        <contextTokenLimit value="1048576"/>
        <!-- defaultMemoryTopK: 记忆召回注入上下文的最大条数 -->
        <defaultMemoryTopK value="50"/>
        <!-- defaultMemoryStore: 默认长期记忆模块名 -->
        <defaultMemoryStore value="dbMemory" />
        <!-- defaultSkillPackageName: Skill类名简写默认包前缀 -->
        <defaultSkillPackageName value="cn.tianlong.tlobject.aiagent.skill.builtin"/>
        <!-- defaultMemoryPackageName: Memory类名简写默认包前缀 -->
        <defaultMemoryPackageName value="cn.tianlong.tlobject.aiagent.memory"/>
        <!-- outputGuard: 输出监管模块名，校验LLM最终回复（不配=关闭） -->
        <outputGuard value="outputGuard"/>
        <!-- enableCheckpoint: 会话断点通知开关。true=Agent向SessionManager发送sessionUpdated/chatFinished/chatAborted。
             主Agent设true，子Agent默认false（不配即不通知）。SessionManager另有enableCheckpoint控制是否落盘。 -->
        <enableCheckpoint value="true"/>
        <!-- sessionManagerName: 会话管理模块名 -->
        <sessionManagerName value="dbSessionManager"/>
        <!-- checkProviderOnStartup: 启动时验证LLM Provider连通性 -->
        <checkProviderOnStartup value="true"/>

        <!-- ===== HITL 审批机制 =====
             审批由共享执行器全局启用（toolExecutor_config.xml 的 approvalModule=approvalGate），
             规则按工具名匹配；master 没有危险工具（file_operation/code_execution），天然不打审批。
             规则和审查人配置见 approvalGate_config.xml
        -->

        <!-- ===== 推理/思考链 (ReAct) 参数 =====
             reasoningMode: 推理模式选择
               - off    (默认) 不干预：什么都不传。⚠ 对推理模型等于"照常推理"——
                        实测 deepseek-v4-flash 不传 thinking 时，稍难一点的提示词就会
                        reasoning_tokens=max_tokens、finish_reason=length、正文为空，
                        纯粹烧 token。要真关请用 disabled
               - disabled 显式关闭推理（发 thinking:{"type":"disabled"}）——
                        汇报/生成类 agent 用这个，预算全给正文
               - prompt 在system prompt中注入💭引导，LLM输出思考文本再调用工具
                        通用方案，适用GPT-4、Qwen等无原生reasoning的模型
               - native 解析LLM原生reasoning字段
                        适用: DeepSeek V3.1+/V4/R1 (reasoning_content) / Claude Fable5/Opus4 (thinking块)
               - auto   自动判断: deepseek-v3/v4/r1 → native, claude-fable5/opus4 → native, 其余 → prompt
             reasoningVisible: true/false  推理内容是否暴露给调用方（默认true）。
               false时推理仍存入对话历史（供调试），但不在返回值中暴露
             thinkingBudget: Claude Extended Thinking的token预算（默认4000，仅native/auto生效）
             运行时切换: 控制台输入 /thinking off|prompt|native|auto
             单次请求:   msg.setParam("reasoningMode", "native")
             注意: 每个子Agent独立配置自己的reasoningMode，主Agent不自动传播
             ⚠ off 与 disabled 的区别是高频误解点：off=不干预（推理模型仍思考），disabled=真关。
               流式链路（webui）此前完全不传 reasoningMode，配了也不生效——已修（TLAiAgent 首包+续跑透传）
        -->
        <!-- reasoningMode: 推理模式 off|disabled|prompt|native|auto，详见上方注释 -->
        <!-- master 是汇报型 agent（把工具结果讲给用户听），思考只会跟正文抢 max_tokens：
             实测一次汇总轮推理 1.3 万字吃光 4096，正文 0 字 → 关掉 -->
        <reasoningMode value="disabled"/>
        <!-- reasoningVisible: 推理内容是否暴露给调用方 -->
        <reasoningVisible value="true"/>
        <!-- thinkingBudget: Claude Extended Thinking token预算（仅native/auto生效） -->
        <thinkingBudget value="4000"/>
        <!-- 不走意图缓存：带审批门禁的工具操作不得被学习/命中缓存 -->
        <intentCache value="false"/>
    </params>

    <providers>
        <!-- ==== 带模型路由的 Provider（装饰器模式）====
             TLRoutingProvider 本身不发起 HTTP 请求，它拦截 completion 调用后：
               1. 根据关键词/LLM 判断任务复杂度
               2. 选择 simpleModel 或 complexModel
               3. 转发给 delegateProvider 执行真正的 API 调用

             delegateProvider="openAiProvider" — 指定"真正干活的 Provider 是谁"。
               这里引用的是模块工厂中已注册的 Provider 类（cn.tianlong.tlobject.aiagent_config.xml 里的 openAiProvider），
               RoutingProvider 会复制其类（TLOpenAiProvider）并注入 apiKey/apiBaseUrl/model 等参数来创建后端实例。

             策略 hybrid = 规则优先 + 未命中时用 simpleModel 做元认知分类。
             简单任务选 deepseek-v4-flash（便宜），复杂任务选 deepseek-v4-flash（强推理）。
             切回无路由：sameClassAs 改回 TLOpenAiProvider，删掉 strategy/delegateProvider/keywords 属性即可。

             ==== 调试追踪（可选，下面两个 provider 都开了）====
               debugMode="true"    每次【非流式】LLM 调用把完整原始请求/响应落盘到 traceDir。
                                   用途=协议级真相：finish_reason / usage / reasoning_tokens / 实际发出的
                                   messages 等 agent 层看不到的字段都在这（今天定位"推理吃光预算"全靠它）；
                                   与 /trace 命令的"环节视图"互补（那个按用户/会话/轮次、payload 有截断）。
                                   关掉（false）零成本不写盘；运行时也可切：给 provider 发 debugOn / debugOff
               traceDir            落盘目录，默认 ./data/traces；文件名 <provider名>_<会话id>.trace（追加式）
               traceFileMaxMB      单个 trace 文件大小上限（MB，默认 20）：本次写入会超限时把当前文件
                                   轮转为 <名字>.1（各留一份）再重开，防单文件无界增长（曾有 176MB 先例）
               读取/清理：provider 暴露 getTraces / clearTraces action（无内置 UI 入口，开发排障用）
        -->
        <!-- 意图路由缓存：cache → routing → openAi 三层装饰链。
             cacheDelegateProvider 指定缓存层目标；delegateProvider 保留给内层 routing。
             停用缓存：sameClassAs 改回 routingProvider、删掉 cacheDelegateProvider -->
        <provider name="openAiProvider"
                  sameClassAs="intentCacheProvider"
                  cacheDelegateProvider="routingProvider"
                  delegateProvider="openAiProvider"
                  statup="true"
                  debugMode="true"
                  traceDir="./data/traces"
                  enablePromptCaching="true"
                  apiKey="sk-your-api-key"
                  apiBaseUrl="https://api.deepseek.com"
                  defaultModel="deepseek-v4-flash"
                  checkProviderOnStartup="true"
                  simpleModel="deepseek-v4-flash"
                  simpleKeywords="你好,hello,hi,是什么,定义,解释,翻译,translate,谢谢,再见,笑话,天气"

                  complexModel="deepseek-v4-flash"
                  complexKeywords="写代码,编程,实现,debug,修复,重构,推理,分析原因,为什么,逻辑,计算,数学,写诗,创作,故事,多步骤,按计划,逐步"

                  strategy="hybrid"/>
        <provider name="embeddingProvider"
                  sameClassAs="openAiProvider"
                  statup="true"
                  debugMode="true"
                  traceDir="./data/traces"
                  apiKey="sk-your-api-key"
                  apiBaseUrl="https://api.deepseek.com"
                  defaultModel="text-embedding-3-small"/>
    </providers>

    <memoryStores>
        <!--memoryStore name="longTermMemory"
                     sameClassAs="longTermMemory"
                     statup="true"
                     memoryType="longTerm"
                     storagePath="./data/master_memory"
                     maxCacheEntries="10000"/-->
        <memoryStore name="dbMemory"
                     sameClassAs="dbMemory"
                     statup="true"
                     memoryType="longTerm"
                     maxCacheEntries="10000"
                     enableEmbedding="false"
                     embeddingProvider="embeddingProvider"
                     embeddingModel="text-embedding-3-small"
                     summaryEnabled="true"
                     summaryBatchSize="20"/>
    </memoryStores>

    <!-- ===== Agent 定义（有此项即为主控模式） ===== -->

    <!-- Agent 说明：
         master 眼里所有子 agent 一视同仁：一律 getMyModule 创建，类由配置决定
         （classfile / sameClassAs），无任何类型特判。

         普通LLM子Agent : sameClassAs="aiagent"，独立TLAiAgent实例，有LLM/Skill/Memory
         MCP桥接Agent   : type="mcp"，无LLM，自动发现tools→展开为N个function defs，
                          classfile=cn.tianlong.tlobject.aiagent.mcp.TLMcpAgent
         Agent组        : sameClassAs="agentGroup"（TLAgentGroup 实例），无LLM，
                          组在自己的 {name}_config.xml 里配置成员名单（<agents> 列表即成员，
                          保序）和 mode（sequential串行链 | parallel并发合并）、waitTime，
                          成员由组内部创建为私有实例，与 master 无关

         通用参数：
           statup     : "true" 启用 | "false" 跳过
           description: LLM选择Agent时的参考描述（md frontmatter 会合并，经消息向实例获取）
           classfile  : 自定义类全路径
           configFile : 配置文件，缺省为 {name}_config.xml
           sameClassAs: 引用工厂中已注册模块的classfile -->
    <agents>
        <agent name="fileAgent"
               sameClassAs="aiagent"
               statup="true"
               description="文件操作专家，读写、列表、删除文件，并支持 Word 文档（.docx）的读取、生成与修改（含表格、模板占位符填充）。仅用于本地文件操作任务。网页下载请用 browser，代码执行请用 codeAgent。"/>

        <agent name="codeAgent"
               sameClassAs="aiagent"
               configfile="codeAgent_config.xml"
               statup="true"
               description="代码执行专家，执行 Python/JS 代码和脚本文件。仅用于需要写代码才能完成的计算/分析/算法任务。网页访问请用 browser，文件操作请用 fileAgent。"/>

        <agent name="priceTeam"
               sameClassAs="agentGroup"
               statup="true"
               description="食品询价组，依次询问汉堡和披萨价格。当用户同时要买汉堡和披萨时使用此Agent。"/>

        <agent name="poemWorkflow"
               sameClassAs="agentWorkflow"
               statup="true"
               configfile="poemWorkflow_config.xml"
               description="诗歌创作工作流，两个不同风格的诗人并行创作后汇总。当用户要求写诗、创作诗歌时使用此Agent。"/>

        <agent name="dbAgent"
               sameClassAs="aiagent"
               statup="false"
               description="数据库处理专家，负责SQL查询、数据操作、表管理等。当用户请求涉及数据库操作时使用此Agent。"/>

        <agent name="planTask"
               sameClassAs="planTask"
               statup="true"
               defaultLlmProvider="aiagent_master:openAiProvider"
               maxToolCallIterations="1"
               defaultTemperature="0.3"
               defaultMaxTokens="2048"
               description="将复杂任务分解为带进度标记的可执行子任务清单（3-7项）。仅当用户需求涉及多步骤、且无法直接委托现有子Agent独立完成时使用（如未知流程编排）。如果子任务已有对应的Agent（如poemWorkflow写诗、priceTeam询价、fileAgent文件操作、codeAgent代码执行），请直接并行委托这些Agent，无需调用本Agent。"/>

    </agents>
    <skills>
        <skill name="viewImageSkill"
               sameClassAs="viewImageSkill"
               statup="true"/>
        <skill name="skillmd_test"
               classfile="cn.tianlong.java.demo.aiagent.skills.TLSkillMdTestSkill"
               configfile="skillmd_test_config.xml"
               statup="true"/>
        <skill name="skillInstallerSkill"
               sameClassAs="skillInstallerSkill"
               statup="true"
               skillName="install_skill"
               skillDescription="将脚本文件安装为可复用的 AI Agent Skill。当用户想把某个脚本（Python/Shell/JS等）安装为 Skill 时使用。"/>

        <!-- ===== Computer Use / GUI Agent (可选) =====
             依赖: pip install playwright && playwright install chromium  (browser)
                   pip install pyautogui mss                           (desktop)
                   实际操作：
                   pip install playwright pyautogui mss -i https://pypi.tuna.tsinghua.edu.cn/simple
                   python -m playwright install chromium
             启用: statup="true" -->
        <!-- 浏览器。已启用真实浏览器模式（③）：agent 通过 CDP 接管系统 Chrome/Edge（专用 profile）。
             浏览器没开时自动拉起（cdpAutoLaunch）；先在浏览器窗口里人工登录，agent 用同一浏览器干活；
             暂不想接管时把 cdpEndpoint/cdpAutoLaunch 两行删掉即可回到②持久化模式。详见 aiagent/README.md -->
        <skill name="browser"
               sameClassAs="browserJavaSkill"
               statup="true"
               interpreter="python"
               maxExecutionTime="60"
               idleTimeoutSeconds="300"
               maxTextChars="30000"
               allowedScriptDir="skills/browser/scripts"
               headless="true"
               userDataDir="data/browser_profile"
               cdpEndpoint="http://127.0.0.1:9222"
               cdpAutoLaunch="true"
               cdpProfileDir="data/browser_agent_profile"
               skillDescription="Browser automation via Playwright (persistent browser session). Navigate to URLs, click elements, fill forms, extract page text/links/tables, and capture screenshots. Use this for ANY task involving websites: opening a URL, web search, scraping, filling forms. The browser session persists across calls — after navigate, subsequent click/type/extract act on the SAME page. Use action=navigate to open a page first, then continue with click/type/extract."/>
        <skill name="schedule_task"
               sameClassAs="scheduleTaskSkill"
               statup="true"
               ownerAgent="aiagent_master"
               msgTaskModule="taskScheduler"
               maxConcurrentTasks="3"
               progressPushIntervalMs="250"
               taskStaleMinutes="30"
               skillDescription="Create and manage tasks (定时任务/后台任务). Two kinds: (1) kind=background — run a LONG task immediately without blocking the conversation (e.g. 股票分析/长报告/批量处理), results come back into this session when done; (2) default schedule — fire at a future time or repeatedly (cron/delay/one_shot), results are reported back at each fire. op=create/list/remove/update/stop. Use kind=background when a request needs long-running analysis or a long report and should not block the chat."/>
        <!-- 桌面自动化：Java 版（纯 JDK Robot，零外部依赖；动作比 Python 版多 double_click/drag/key/
             wait/get_mouse_position/paste）。回退 Python 版 = 把 sameClassAs 改回 "scriptExecutionSkill"
             并恢复 interpreter/allowedScriptDir 两行 -->
        <skill name="desktop"
               sameClassAs="desktopJavaSkill"
               statup="true"
               maxExecutionTime="30"
               maxShotHeight="1080"/>
    </skills>
    <!-- ===== msgTools: LLM 可调用的预定义消息 =====

         两种形态：
         1. 有 action：直接执行到 destination（缺省发给本 agent 自己）
         2. 只有 msgid 无 action：框架按 msgid 查 destination 模块（或本 agent 自己）的
            <msgTable>，一个 msgid 可对应多条 msg 顺序执行
            （msgTable 格式见 <msgTable> 注释示例）

         通用参数：
           statup     : "true" 启用 | "false" 跳过
           description: LLM 看到的工具描述
           destination: 目标模块（缺省=本 agent），无 action 时消息以 msgid 发给该模块,
                        其 getMsg() 会查 checkMsgId()→msgTable 路由
           paramsFromArgs : LLM 可传参数（分号分隔），自动生成函数 schema
           paramsFromMsg  : 框架自动注入的参数（分号分隔） -->
    <!-- ===== msgTable: 消息路由表 =====
         msgid 可配运行参数：mode="parallel" 并发收集全部结果；不配默认 sequential 顺序返回末条。
         waitTime 可设并行超时毫秒（默认 120000）。 -->
    <msgTable>
        <msgid value="healthCheck" mode="parallel" waitTime="30000">
            <msg action="listSkills" destination="aiagent_master" />
            <msg action="getTurnCount" destination="aiContext" />
            <msg action="checkProvider" destination="aiagent_master" />
        </msgid>
        <msgid value="getConversationStats">
            <msg action="getTurnCount" destination="aiContext" />
        </msgid>
        <msgid value="getServerStatus" mode="parallel" waitTime="30000">
            <msg action="listSkills" destination="aiagent_master" />
            <msg action="listAgents" destination="aiagent_master" />
        </msgid>
    </msgTable>

    <msgTools>
        <msg msgid="getServerStatus"
             statup="true"
             description="获取服务器运行状态，返回当前已注册的所有Skills和子Agent列表"/>
        <msg msgid="getConversationStats"
             statup="true"
             description="获取当前会话的对话统计信息，包括消息总数"/>
        <msg msgid="healthCheck"
             statup="true"
             description="综合健康检查：查询服务器状态+对话统计+provider连通性，一次并行调用获取全部信息。"/>
        <!-- 带参数 msgTool 示例（statup=false，注释仅供参照）：
        <msg msgid="saveMemory"
             statup="false"
             description="保存一条长期记忆。"
             paramsFromArgs="memKey;memValue;memTag"     LLM可传的参数，自动生成函数schema
             paramsFromMsg="sessionId"/>                 框架自动从chat消息注入的参数 -->
    </msgTools>

    <beforeMsgTable>
        <action name="chat">
            <dmsg action="saveCheckpoint" destination="checkpoint" ifHistory="true" />
            <msg action="recallAgentMemory" destination="aiagent_master"
                 paramsFromMsg="sessionId;userId;userMessage"/>
        </action>
        <!-- 流式路径同样召回长期记忆（Web 默认流式；缺此钩子会导致流式对话无跨会话记忆） -->
        <action name="chatStream">
            <msg action="recallAgentMemory" destination="aiagent_master"
                 paramsFromMsg="sessionId;userId;userMessage"/>
        </action>
    </beforeMsgTable>
    <afterMsgTable>
        <action name="chat" >
            <!--  dmsg 为方便的注释掉 ，dmsg不解析为msg   -->
            <dmsg action="clearAndForward" destination="checkpoint"  />
            <!--msg action="reviewChat" destination="errorSupervisor" maxReviewRounds="2"/-->
        </action>
    </afterMsgTable>

    <modulesParams>
        <!-- aiContext 模块参数：maxContextMessages=历史条数上限；toolResultCharLimit=tool 结果入史最大字符数
             （源头截断：browser 整页抓取/大文件读取等巨量输出入库前限长，防上下文超限 400 与历史膨胀；0=不限） -->
        <module name="aiContext" maxContextMessages="50" toolResultCharLimit="20000" defaultSystemMessage="你是一个智能助手，当前日期 {{date}}，会话ID {{sessionId}}。回复时注意：绝对不要使用任何emoji表情符号（如汉堡披萨金钱等图标），全部使用纯文本。表格中也不要插入emoji。

当你缺少必要信息无法完成任务时，调用 request_clarification 工具请求用户确认，不要猜测。

如果子 agent 的返回结果中包含「请求确认」字眼，你应该向用户转达确认问题，拿到回复后重新委托给子 agent。

## 复杂任务处理规则

如果任务只需单步完成（如纯知识问答、简单计算、单次查询），直接回答。

如果需要调用 2 个及以上工具（包括 delegate_to_*、skill、msgTool），应先判断：子任务是否已有现成的 Agent 可直接委托？有则直接并行委托。若子任务之间无现成 Agent 对应、需要编排未知流程，再使用任务规划工具进行分解，按清单逐步执行并更新进度。"/>
    </modulesParams>

</moduleConfig>
