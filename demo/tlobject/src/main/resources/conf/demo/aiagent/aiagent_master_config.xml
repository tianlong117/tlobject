<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <!-- ===== 主控Agent配置示例 ===== -->
    <!-- 有<agents>段 → 自动切换为主控模式 -->
    <!-- 子Agent的"tools" = delegate_to_fileAgent, delegate_to_dbAgent -->

    <params>
        <defaultLlmProvider value="openAiProvider"/>
        <maxToolCallIterations value="10"/>
        <defaultTemperature value="0.7"/>
        <defaultMaxTokens value="4096"/>
        <defaultMemoryTopK value="50"/>
        <defaultMemoryStore value="dbMemory" />
        <defaultSkillPackageName value="cn.tianlong.tlobject.aiagent.skill.builtin"/>
        <defaultMemoryPackageName value="cn.tianlong.tlobject.aiagent.memory"/>
        <outputGuard value="outputGuard"/>
        <enableCheckpoint value="true"/>
        <checkProviderOnStartup value="true"/>

        <!-- ===== HITL 审批机制 =====
             approvalModule: 审批模块名（空字符串 = 不启用，改为 "approvalGate" 启用）
             审批规则和审查人配置见 approvalGate_config.xml
        -->
        <approvalModule value=""/>

        <!-- ===== 推理/思考链 (ReAct) 参数 =====
             reasoningMode: 推理模式选择
               - off    (默认) 不处理推理，省token。什么也不做
               - prompt 在system prompt中注入💭引导，LLM输出思考文本再调用工具
                        通用方案，适用GPT-4、Qwen等无原生reasoning的模型
               - native 解析LLM原生reasoning字段
                        适用: DeepSeek V3.1+/V4/R1 (reasoning_content) / Claude Fable5/Opus4 (thinking块)
               - auto   自动判断: deepseek-v3/v4/r1 → native, claude-fable5/opus4 → native, 其余 → prompt
             reasoningVisible: true/false  推理内容是否暴露给调用方（默认true）。
               false时推理仍存入对话历史（供调试），但不在返回值中暴露
             thinkingBudget: Claude Extended Thinking的token预算（默认4000，仅native/auto生效）
             运行时切换: 控制台输入 /thinking off|prompt|native|auto
             单次请求:   msg.setParam("reasoningMode", "native")
             注意: 每个子Agent独立配置自己的reasoningMode，主Agent不自动传播
        -->
        <reasoningMode value="native"/>
        <reasoningVisible value="true"/>
        <thinkingBudget value="4000"/>
    </params>

    <providers>
        <!-- ==== 带模型路由的 Provider ====
             策略 hybrid = 规则优先 + 未命中时用 simpleModel 做元认知分类。
             简单任务选 ddeepseek-v4-flash（便宜），复杂任务选 deepseek-v4-pro（强推理）。
             切回无路由：classfile 改回 TLOpenAiProvider，删掉 strategy/delegateProvider/keywords 属性即可。
        -->
        <provider name="openAiProvider"
                  sameClassAs="routingProvider"
                  delegateProvider="openAiProvider"
                  statup="true"
                  debugMode="true"
                  traceDir="./data/traces"
                  apiKey="sk-your-api-key"
                  apiBaseUrl="https://api.deepseek.com"
                  defaultModel="deepseek-v4-flash"

                  simpleModel="deepseek-v4-flash"
                  simpleKeywords="你好,hello,hi,是什么,定义,解释,翻译,translate,谢谢,再见,笑话,天气"

                  complexModel="deepseek-v4-pro"
                  complexKeywords="写代码,编程,实现,debug,修复,重构,推理,分析原因,为什么,逻辑,计算,数学,写诗,创作,故事,多步骤,按计划,逐步"

                  strategy="hybrid"/>
        <provider name="embeddingProvider"
                  sameClassAs="openAiProvider"
                  statup="true"
                  debugMode="true"
                  traceDir="./data/traces"
                  apiKey="sk-your-api-key"
                  apiBaseUrl="https://api.deepseek.com"
                  defaultModel="text-embedding-3-small"/>
    </providers>

    <memoryStores>
        <!--memoryStore name="longTermMemory"
                     sameClassAs="longTermMemory"
                     statup="true"
                     memoryType="longTerm"
                     storagePath="./data/master_memory"
                     maxCacheEntries="10000"/-->
        <memoryStore name="dbMemory"
                     sameClassAs="dbMemory"
                     statup="true"
                     memoryType="longTerm"
                     maxCacheEntries="10000"
                     enableEmbedding="false"
                     embeddingProvider="embeddingProvider"
                     embeddingModel="text-embedding-3-small"/>
    </memoryStores>

    <!-- ===== Agent 定义（有此项即为主控模式） ===== -->

    <!-- Agent 说明：
         master 眼里所有子 agent 一视同仁：一律 getMyModule 创建，类由配置决定
         （classfile / sameClassAs），无任何类型特判。

         普通LLM子Agent : sameClassAs="aiagent"，独立TLAiAgent实例，有LLM/Skill/Memory
         MCP桥接Agent   : type="mcp"，无LLM，自动发现tools→展开为N个function defs，
                          classfile=cn.tianlong.tlobject.aiagent.mcp.TLMcpAgent
         Agent组        : sameClassAs="agentGroup"（TLAgentGroup 实例），无LLM，
                          组在自己的 {name}_config.xml 里配置成员名单（<agents> 列表即成员，
                          保序）和 mode（sequential串行链 | parallel并发合并）、waitTime，
                          成员由组内部创建为私有实例，与 master 无关

         通用参数：
           statup     : "true" 启用 | "false" 跳过
           description: LLM选择Agent时的参考描述（md frontmatter 会合并，经消息向实例获取）
           classfile  : 自定义类全路径
           configFile : 配置文件，缺省为 {name}_config.xml
           sameClassAs: 引用工厂中已注册模块的classfile -->
    <agents>
        <agent name="fileAgent"
               sameClassAs="aiagent"
               statup="true"
               description="文件操作专家，读写、列表、删除文件。仅用于本地文件操作任务。网页下载请用 browser，代码执行请用 codeAgent。"/>

         <!--agent name="cloudRevenueAgent"
               sameClassAs="aiagent"
               statup="true"
               description="联通云收入统计分析师，使用Python脚本处理月度云资源业务明细表，按归属单位和云类型统计收入并输出Excel汇总。当用户提到联通云、云资源、收入统计时使用此Agent。"/-->

        <agent name="codeAgent"
               sameClassAs="aiagent"
               configfile="codeAgent_config.xml"
               statup="true"
               description="代码执行专家，执行 Python/JS 代码和脚本文件。仅用于需要写代码才能完成的计算/分析/算法任务。网页访问请用 browser，文件操作请用 fileAgent。"/>

        <agent name="priceTeam"
               sameClassAs="agentGroup"
               statup="true"
               description="食品询价组，依次询问汉堡和披萨价格。当用户同时要买汉堡和披萨时使用此Agent。"/>

        <agent name="poemWorkflow"
               sameClassAs="agentWorkflow"
               statup="true"
               configfile="demoWorkflow_config.xml"
               description="诗歌创作工作流，两个不同风格的诗人并行创作后汇总。当用户要求写诗、创作诗歌时使用此Agent。"/>

        <agent name="dbAgent"
               sameClassAs="aiagent"
               statup="false"
               description="数据库处理专家，负责SQL查询、数据操作、表管理等。当用户请求涉及数据库操作时使用此Agent。"/>

    </agents>
    <skills>
        <skill name="liantongyun"
               sameClassAs="scriptExecutionSkill"
               statup="true"
               interpreter="python"
               maxExecutionTime="120"
               allowedScriptDir="skills/liantongyun/scripts"/>
        <skill name="skillmd_test"
               classfile="cn.tianlong.java.demo.aiagent.skills.TLSkillMdTestSkill"
               configfile="skillmd_test_config.xml"
               statup="true"/>
        <skill name="planTask"
               sameClassAs="planTask"
               statup="true"
               skillDescription="将复杂任务分解为带进度标记的可执行子任务清单（3-7项）。仅当用户需求涉及多步骤、且无法直接委托现有子Agent独立完成时使用（如未知流程编排）。如果子任务已有对应的Agent（如poemWorkflow写诗、priceTeam询价、fileAgent文件操作、codeAgent代码执行），请直接并行委托这些Agent，无需调用本技能。"/>
        <skill name="skillInstallerSkill"
               sameClassAs="skillInstallerSkill"
               statup="true"
               skillName="install_skill"
               skillDescription="将脚本文件安装为可复用的 AI Agent Skill。当用户想把某个脚本（Python/Shell/JS等）安装为 Skill 时使用。"/>

        <!-- ===== Computer Use / GUI Agent (可选) =====
             依赖: pip install playwright && playwright install chromium  (browser)
                   pip install pyautogui mss                           (desktop)
                   实际操作：
                   pip install playwright pyautogui mss -i https://pypi.tuna.tsinghua.edu.cn/simple
                   python -m playwright install chromium
             启用: statup="true" -->
        <skill name="browser"
               sameClassAs="scriptExecutionSkill"
               statup="true"
               interpreter="python"
               maxExecutionTime="60"
               allowedScriptDir="skills/browser/scripts"
               skillDescription="Browser automation via Playwright. Navigate to URLs, click elements, fill forms, extract page text/links/tables, and capture screenshots. Use this for ANY task involving websites: opening a URL, web search, scraping, filling forms. Start with navigate to open a page, then use click/type/extract as needed."/>
        <skill name="desktop"
               sameClassAs="scriptExecutionSkill"
               statup="true"
               interpreter="python"
               maxExecutionTime="30"
               allowedScriptDir="skills/desktop/scripts"/>
    </skills>
    <!-- ===== msgTools: LLM 可调用的预定义消息 =====

         两种形态：
         1. 有 action：直接执行到 destination（缺省发给本 agent 自己）
         2. 只有 msgid 无 action：框架按 msgid 查 destination 模块（或本 agent 自己）的
            <msgTable>，一个 msgid 可对应多条 msg 顺序执行
            （msgTable 格式见 <msgTable> 注释示例）

         通用参数：
           statup     : "true" 启用 | "false" 跳过
           description: LLM 看到的工具描述
           destination: 目标模块（缺省=本 agent），无 action 时消息以 msgid 发给该模块,
                        其 getMsg() 会查 checkMsgId()→msgTable 路由
           paramsFromArgs : LLM 可传参数（分号分隔），自动生成函数 schema
           paramsFromMsg  : 框架自动注入的参数（分号分隔） -->
    <!-- ===== msgTable: 消息路由表 =====
         msgid 可配运行参数：mode="parallel" 并发收集全部结果；不配默认 sequential 顺序返回末条。
         waitTime 可设并行超时毫秒（默认 120000）。 -->
    <msgTable>
        <msgid value="healthCheck" mode="parallel" waitTime="30000">
            <msg action="listSkills" destination="aiagent_master" />
            <msg action="getTurnCount" destination="aiContext" />
            <msg action="checkProvider" destination="aiagent_master" />
        </msgid>
    </msgTable>

    <msgTools>
        <msg msgid="getServerStatus"
             statup="true"
             description="获取服务器运行状态，返回当前已注册的所有Skills和子Agent列表"
             action="listSkills"
             destination="aiagent_master"/>
        <msg msgid="getConversationStats"
             statup="true"
             description="获取当前会话的对话统计信息，包括消息总数"
             action="getTurnCount"
             destination="aiContext"/>
        <msg msgid="healthCheck"
             statup="true"
             description="综合健康检查：查询服务器状态+对话统计+provider连通性，一次并行调用获取全部信息。"/>
        <!-- 带参数 msgTool 示例（statup=false，注释仅供参照）：
        <msg msgid="saveMemory"
             statup="false"
             description="保存一条长期记忆。"
             action="saveAgentMemory"
             destination="aiagent_master"
             paramsFromArgs="memKey;memValue;memTag"     LLM可传的参数，自动生成函数schema
             paramsFromMsg="sessionId"/>                 框架自动从chat消息注入的参数 -->
    </msgTools>

    <beforeMsgTable>
        <action name="chat">
            <dmsg action="saveCheckpoint" destination="checkpoint" ifHistory="true" />
            <msg action="recallAgentMemory" destination="aiagent_master"
                 paramsFromMsg="sessionId;userId;userMessage"/>
        </action>
    </beforeMsgTable>
    <afterMsgTable>
        <action name="chat" >
            <!--  dmsg 为方便的注释掉 ，dmsg不解析为msg   -->
            <dmsg action="clearAndForward" destination="checkpoint"  />
            <!--msg action="reviewChat" destination="errorSupervisor" maxReviewRounds="2"/-->
        </action>
    </afterMsgTable>

    <modulesParams>
        <module name="aiContext" defaultSystemMessage="你是一个智能助手，当前日期 {{date}}，会话ID {{sessionId}}。回复时注意：绝对不要使用任何emoji表情符号（如汉堡披萨金钱等图标），全部使用纯文本。表格中也不要插入emoji。

当你缺少必要信息无法完成任务时，调用 request_clarification 工具请求用户确认，不要猜测。

如果子 agent 的返回结果中包含「请求确认」字眼，你应该向用户转达确认问题，拿到回复后重新委托给子 agent。

## 复杂任务处理规则

如果任务只需单步完成（如纯知识问答、简单计算、单次查询），直接回答。

如果需要调用 2 个及以上工具（包括 delegate_to_*、skill、msgTool），应先判断：子任务是否已有现成的 Agent 可直接委托？有则直接并行委托。若子任务之间无现成 Agent 对应、需要编排未知流程，再使用任务规划工具进行分解，按清单逐步执行并更新进度。"/>
    </modulesParams>

</moduleConfig>
