<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <!-- ===== 主控Agent配置示例 ===== -->
    <!-- 有<agents>段 → 自动切换为主控模式 -->
    <!-- 子Agent的"tools" = delegate_to_fileAgent, delegate_to_dbAgent -->

    <params>
        <defaultLlmProvider value="openAiProvider"/>
        <maxToolCallIterations value="10"/>
        <defaultModel value="gpt-4o"/>
        <defaultTemperature value="0.7"/>
        <defaultMaxTokens value="4096"/>
        <defaultMemoryTopK value="50"/>
        <defaultMemoryStore value="dbMemory" />
        <defaultSkillPackageName value="cn.tianlong.tlobject.aiagent.skill.builtin"/>
        <defaultMemoryPackageName value="cn.tianlong.tlobject.aiagent.memory"/>
        <outputGuard value="outputGuard"/>
        <enableCheckpoint value="true"/>
        <checkProviderOnStartup value="true"/>
    </params>

    <providers>
        <provider name="openAiProvider"
                  sameClassAs="openAiProvider"
                  statup="true"
                  debugMode="true"
                  traceDir="./data/traces"
                  apiKey="sk-your-api-key"
                  apiBaseUrl="https://api.deepseek.com"
                  defaultModel="deepseek-v4-pro"/>
    </providers>

    <memoryStores>
        <!--memoryStore name="longTermMemory"
                     sameClassAs="longTermMemory"
                     statup="true"
                     memoryType="longTerm"
                     storagePath="./data/master_memory"
                     maxCacheEntries="10000"/-->
        <memoryStore name="dbMemory"
                     sameClassAs="dbMemory"
                     statup="true"
                     memoryType="longTerm"
                     maxCacheEntries="10000"/>
    </memoryStores>

    <!-- ===== Agent 定义（有此项即为主控模式） ===== -->

    <!-- type 取值说明：
         "agent" (默认) : 普通LLM子Agent，独立TLAiAgent实例，有LLM/Skill/Memory
         "mcp"          : MCP桥接Agent，无LLM，自动发现tools→展开为N个function defs
         "group"        : Agent组，不创建实例，主控内部按mode调度members

         group 专属参数：
           mode       : "sequential"(默认,串行链) | "parallel"(并发合并)
           members    : 成员列表，分号分隔，值对应其他 <agent name="...">
           waitTime   : 并行超时毫秒数，默认120000

         mcp 专属参数：
           transport  : "stdio"(子进程) | "sse"(HTTP远程)
           command/args/url : 按transport选填
           tools      : 逗号分隔的工具白名单，不填则全部暴露
           classfile  : cn.tianlong.tlobject.aiagent.mcp.TLMcpAgent

         通用参数：
           statup     : "true" 启用 | "false" 跳过
           description: LLM选择Agent时的参考描述
           classfile  : 自定义类全路径，缺省为TLAiAgent
           configFile : 配置文件，缺省为 {name}_config.xml
           sameClassAs: 引用同段另一个agent的classfile -->
    <agents>
        <agent name="fileAgent"
               sameClassAs="aiagent"
               statup="true"
               description="文件处理专家，负责文件的读写、目录操作等。注意：不执行脚本，如需运行.py/.sh等脚本请用codeAgent。当用户请求涉及文件操作（读、写、列表、删除）时使用此Agent。"/>

        <agent name="hamburgerAgent"
               sameClassAs="aiagent"
               statup="false"
               description="汉堡店店员，专门处理汉堡相关的咨询和下单。汉堡2块钱一个。当用户只买汉堡时使用此Agent。注意：如果用户同时要买汉堡和披萨，必须使用 priceTeam 而非分别调用。"/>

        <agent name="pizzaAgent"
               sameClassAs="aiagent"
               statup="false"
               description="披萨店店员，专门处理披萨相关的咨询和下单。披萨3块钱一个。当用户只买披萨时使用此Agent。注意：如果用户同时要买汉堡和披萨，必须使用 priceTeam 而非分别调用。"/>

        <agent name="cloudRevenueAgent"
               sameClassAs="aiagent"
               statup="true"
               description="联通云收入统计分析师，使用Python脚本处理月度云资源业务明细表，按归属单位和云类型统计收入并输出Excel汇总。当用户提到联通云、云资源、收入统计时使用此Agent。"/>

        <agent name="codeAgent"
               sameClassAs="aiagent"
               statup="true"
               description="代码执行专家，可执行内联代码或运行.py/.sh等脚本文件。当用户要求运行脚本、执行代码、计算、数据处理时使用此Agent。"/>

        <agent name="priceTeam"
               type="group"
               members="hamburgerAgent;pizzaAgent"
               mode="parallel"
               statup="true"
               description="食品询价组，依次询问汉堡和披萨价格。当用户同时要买汉堡和披萨时使用此Agent。"/>

        <agent name="dbAgent"
               sameClassAs="aiagent"
               statup="false"
               description="数据库处理专家，负责SQL查询、数据操作、表管理等。当用户请求涉及数据库操作时使用此Agent。"/>

    </agents>

    <!-- ===== msgTools: LLM 可调用的预定义消息 ===== -->
    <msgTools>
        <msg msgid="getServerStatus"
             statup="true"
             description="获取服务器运行状态，返回当前已注册的所有Skills和子Agent列表"
             action="listSkills"
             destination="aiagent_master"/>
        <msg msgid="getConversationStats"
             statup="true"
             description="获取当前会话的对话统计信息，包括消息总数"
             action="getTurnCount"
             destination="aiContext"/>
        <!-- 带参数 msgTool 示例（注释，仅供参照）：
        <msg msgid="saveMemory"
             statup="false"
             description="保存一条长期记忆。"
             action="saveAgentMemory"
             destination="aiagent_master"
             paramsFromArgs="memKey;memValue;memTag"     LLM可传的参数，自动生成函数schema
             paramsFromMsg="sessionId"/>                 框架自动从chat消息注入的参数 -->
    </msgTools>

    <beforeMsgTable>
        <action name="chat">
            <dmsg action="saveCheckpoint" destination="checkpoint" ifHistory="true" />
            <msg action="recallAgentMemory" destination="aiagent_master"
                 paramsFromMsg="sessionId;userId;userMessage"/>
        </action>
    </beforeMsgTable>
    <afterMsgTable>
        <action  value="chat" >
            <dmsg   action="clearAndForward" destination="checkpoint"  />
        </action>
    </afterMsgTable>

    <modulesParams>
        <module name="aiContext" defaultSystemMessage="你是一个智能助手。回复时注意：绝对不要使用任何emoji表情符号（如汉堡披萨金钱等图标），全部使用纯文本。表格中也不要插入emoji。"/>
    </modulesParams>
</moduleConfig>
