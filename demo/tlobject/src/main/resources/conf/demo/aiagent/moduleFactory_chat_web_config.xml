<?xml version="1.0" encoding="UTF-8"?>
<!--
    AI Agent 控制台 + Web 交互窗口 双入口配置（AIStart -web 使用）
    通过 include 合并 moduleFactory_chat_config.xml 的模块声明；
    include 不合并 commonParams/factoryBoot，因此本文件自带控制中心参数与启动序列。
-->
<moduleConfig>
    <include file="CLASSPATH/conf/demo/aiagent/moduleFactory_chat_config.xml"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.servletutils_config.xml" includeUnit="modules"/>
    <commonParams>
        <ifLog value="true"/>
        <logWait value="false" />
        <loglevel value="trace"/>
        <controlCenterName value="controlCenter"/>
    </commonParams>

    <!-- Web UI 模块 + Jetty 参数 -->
    <modules>
        <module name="webui" classfile="cn.tianlong.tlobject.aiagent.webui.TLWebChatModule" singleton="true"/>
    </modules>
    <modulesParams>
        <module name="controlCenter" configfile="controlCenter_web_config.xml"/>
        <module name="webui" userModule="demoUserModule" passwords="admin:123456;guest:123456"
                uploadSizeMaxMB="50" subscribeToolProgress="true" subscribeWorkflowProgress="true"/>
        <!-- servletPath="/api/" → initServletDispatch 挂唯一 TLServletDispatch 到 /api/*
             （与 appConfig 的 tlobjectPath="/api" 配套，全部框架请求走它，仿 ltbgtadmin 模式；
              不使用 extraServlets 再造 dispatch 实例，避免线程 Map 竞争覆盖）
             / 与 /webui/* 静态页由 TLWebChatServlet 服务 -->
        <module name="jettyServer"
                port="58080"
                connector="http"
                servletPath="/api/"
                extraServlets="/=cn.tianlong.tlobject.aiagent.webui.TLWebChatServlet;/webui/*=cn.tianlong.tlobject.aiagent.webui.TLWebChatServlet"/>
    </modulesParams>

    <!-- 基础设施启动序列；应用模块序列与 webui/jettyServer 由控制中心 startMsg 编排
         （controlCenter_web_config.xml） -->
    <factoryBoot>
        <msg action="getModule" destination="moduleFactory" moduleName="logThreadPool"/>
        <msg action="getModule" destination="moduleFactory" moduleName="threadPool" usePreReturnMsg="false"/>
        <msg action="getModule" destination="moduleFactory" moduleName="database" usePreReturnMsg="false"/>
        <msg action="getModule" destination="moduleFactory" moduleName="controlCenter"/>
    </factoryBoot>
</moduleConfig>
