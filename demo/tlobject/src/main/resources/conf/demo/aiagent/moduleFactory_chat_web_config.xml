<?xml version="1.0" encoding="UTF-8"?>
<!--
    AI Agent 控制台 + Web 交互窗口 双入口配置（AIStart -web 使用）
    通过 include 合并 moduleFactory_chat_config.xml 的模块声明；
    include 不合并 commonParams/factoryBoot，因此本文件自带控制中心参数与启动序列。
-->
<moduleConfig>
    <include file="CLASSPATH/conf/demo/aiagent/moduleFactory_chat_config.xml"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.servletutils_config.xml" includeUnit="modules"/>
    <commonParams>
        <ifLog value="true"/>
        <logWait value="false" />
        <loglevel value="trace"/>
        <controlCenterName value="controlCenter"/>
    </commonParams>

    <!-- Web UI 模块 + Jetty 参数 -->
    <modules>
        <module name="webui" classfile="cn.tianlong.tlobject.aiagent.webui.TLWebChatModule" singleton="true"/>
        <!-- 彻底删除用户数据编排器（用户域模块；经控制中心注册表发现 Agent/技能/记忆的清理能力） -->
        <module name="userDataPurger"
                classfile="cn.tianlong.tlobject.aiagent.user.TLUserDataPurger"
                singleton="true"/>
    </modules>
    <modulesParams>
        <module name="controlCenter" configfile="controlCenter_web_config.xml"/>
        <module name="webui" userModule="dbUserModule"
                uploadSizeMaxMB="50" subscribeToolProgress="true" subscribeWorkflowProgress="true"
                captchaTtlSeconds="300" userDataPurger="userDataPurger"/>
        <module name="userDataPurger"
                userModule="dbUserModule"
                sessionManager="dbSessionManager"
                approvalModule="approvalGate"
                agentMonitor="agentMonitor"
                webui="webui"
                dataRoot="./data"
                purgeWaitMs="5000"/>
        <!-- servletPath="/api/" → initServletDispatch 挂唯一 TLServletDispatch 到 /api/*
             （与 appConfig 的 tlobjectPath="/api" 配套，全部框架请求走它，仿 ltbgtadmin 模式；
              不使用 extraServlets 再造 dispatch 实例，避免线程 Map 竞争覆盖）
             静态页由通用 TLStaticFileServlet 服务：静态页属于应用资产，放在
             {configDir}/webui/（root=webui）；文件系统未命中时回退 classpath /webui/（兼容 UI 打进 jar）。
             "/" 映射只做 302 到首页。servlet 参数经 extraServlets 的 ?k=v&k2=v2 传递。 -->

        <!-- jettyServer 访问日志参数（全部可选；不配 accessLog 即关闭，其它 Jetty 实例默认不写访问日志）：
             accessLog            开启开关 + 输出目标。
                                  · 文件：相对路径按进程 CWD 解析，父目录不存在会自动创建；
                                    例 accessLog="./logs/tllog4j/jetty_access_yyyy_MM_dd.log"
                                  · 控制台：accessLog="stdout"（每条一行，便于开发期直接看）
             accessLogFormat      日志格式。不配=NCSA（本地时区、英文月份，形如
                                  IP - - [24/Nov/2026:21:45:45 +0800] "GET / HTTP/1.1" 200 16111）；
                                  extended=NCSA 再追加 Referer 和 User-Agent；
                                  其它值按 Jetty 格式串原样使用（%t 可用 %{格式|时区|语言}t 定制），
                                  例 accessLogFormat="%{client}a %r %s %O"
             accessLogIgnorePaths 不记录访问日志的路径，分号分隔，支持 /* 通配；
                                  例 accessLogIgnorePaths="/api/events;/webui/*"（SSE 长连接在断开时才落一行）
             accessLogAppend      文件模式是否追加写，默认 true；false 时启动会把旧文件改名备份后新建
             accessLogRetainDays  滚动日志保留天数，仅当文件名含 yyyy_MM_dd 时生效（按本地时区零点切日）；
                                  普通固定文件名不滚动，此参数被忽略
             注意：日志中的客户端 IP 是 TCP 对端地址，经 nginx 等反向代理时会记录代理 IP。
             当前配置：NCSA 格式按天滚动写 ./logs/tllog4j/jetty_access_yyyy_MM_dd.log，保留 7 天。 -->
        <module name="jettyServer"
                port="58080"
                connector="http"
                servletPath="/api/"
                accessLog="./logs/tllog4j/jetty_access_yyyy_MM_dd.log"
                accessLogRetainDays="7"
                extraServlets="/=cn.tianlong.tlobject.servletutils.TLStaticFileServlet?indexRedirect=/webui/chat.html;/webui/*=cn.tianlong.tlobject.servletutils.TLStaticFileServlet?root=webui&amp;fallbackClasspath=/webui&amp;indexRedirect=/webui/chat.html"/>
    </modulesParams>

    <!-- 基础设施启动序列；应用模块序列与 webui/jettyServer 由控制中心 startMsg 编排
         （controlCenter_web_config.xml） -->
    <factoryBoot>
        <msg action="getModule" destination="moduleFactory" moduleName="logThreadPool"/>
        <msg action="getModule" destination="moduleFactory" moduleName="threadPool" usePreReturnMsg="false"/>
        <msg action="getModule" destination="moduleFactory" moduleName="database" usePreReturnMsg="false"/>
        <msg action="getModule" destination="moduleFactory" moduleName="controlCenter"/>
    </factoryBoot>
</moduleConfig>
