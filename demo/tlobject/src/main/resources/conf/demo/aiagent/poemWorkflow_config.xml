<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  DAG 工作流 Demo 配置说明
  ============================================================

  标准框架配置格式：<moduleConfig> 为根，<params>/<modules> 为标准段，
  <nodes>/<edges> 为工作流自定义段（由 TLAgentWorkflow.myConfig 解析）。

  一、DAG 工作流核心思想：
    大任务拆成多个小任务（节点），用有向边声明依赖关系。
    引擎自动推导执行顺序——无依赖的并行跑，有依赖的等前置完成。

  二、节点类型：
    agent     - 调用自有模块（id = <modules> 中定义的模块名）
    condition - 条件分支，根据上游产出表达式判断走哪条边
    fanout    - 扇出，一份输入复制给所有下游
    join      - 汇聚，等待上游全部完成后合并产出

  三、模块定义（标准 <modules> 段）：
    工作流节点的模块自包含，不依赖工厂级单例。
    初始化时 getMyModule 创建私有实例（与 TLAgentGroup 创建成员同模式）。

  四、执行流程（本配置）：
    input(fanout) ─┬─→ poetA ─┬─→ merge(join) → 返回结果
                   └─→ poetB ─┘

  五、作为子Agent使用（在主Agent配置中声明，非本文件）：
    <agent name="poemWorkflow" sameClassAs="agentWorkflow"
           configfile="demoWorkflow_config.xml"
           description="诗歌创作工作流，两个不同风格诗人并行创作后汇总"/>

  六、表达式模式（可选替代 <nodes>/<edges>）：
    在 <params> 里配置 <expression value="..."/>（框架 <params> 段格式：元素名作 key，
    不是 <param name="..." value="..."/> 写法），
    逻辑表达式会被编译成 DAG（节点/边自动生成），效果等同手写 nodes/edges。
    表达式是"前端语法"，nodes/edges 是"中间表示"，引擎执行的始终是后者。

    语法（优先级 -> 最松 > || > &&，括号可任意嵌套）：
      A && B   并行：A、B 都跑，全部完成后继续（&& 自动生成汇聚节点）
      A || B   回退：A 失败才跑 B（A 成功则 B 被跳过）
      A -> B   顺序：B 等 A 完成，且 A 的产出正文（aiResponse）自动并入 B 的提示词
               （多个上游时带【节点名】分段；原始任务不前置——它是上游节点的职责，
                下游节点职责由其 systemMessage 定义）
     agent 通用参数（工作流 <modules> 条目同样适用，作用于所有 agent）：
       systemMessage — 人设/规矩（注入 context 的 defaultSystemMessage，显式配置优先于 md 正文）
       task          — 固定任务前缀（每次收到的消息前置，user 层权重最高）
       temperature   — 采样温度（defaultTemperature 的别名）
      if (A.aiResponse == "xx") B else C   值分支：按上游产出判断走哪条
      组合示例：(A || B) -> C、A -> if (A.aiResponse == "ok") B else C
    注意：
      · 表达式里每个 IDENT 都是 AGENT 节点，必须对应 <modules> 里声明的模块名
        （本配置即 poetA/poetB/poetc）
      · JOIN/FANOUT/CONDITION 由编译器自动生成（__e1、__e2...），不能作为 IDENT 写
      · 工具类模块（如 MCP 的 filesystemMcp）不能作为工作流节点（节点一律发 chat，
        MCP 无 chat 动作会 FAILED）——应声明为节点 Agent 的 <agents> 工具
        （见 poetc_config.xml：factoryShared 共享主工厂实例）
      · 本配置的表达式等价写法：poetA && poetB
        （原 DAG 的 merge join 由 && 自动汇聚替代，结果自动汇总所有节点产出）

    运行时优先级：msg 的 expression > msg 的 nodes/edges > XML expression > XML nodes/edges
    （XML expression 在启动期编译一次并缓存，失败回退 <nodes>/<edges>；
     表达式节点与静态节点一样在启动期初始化，失败当场报错；
     msg 级动态表达式在执行期惰性创建节点）

    XML 转义：属性值里 & 是非法字符（实体引用起始符），&& 必须写 &amp;&amp;，
    解析后自动还原为 &&，运行时表达式与手写完全一致。
  ============================================================
-->
<moduleConfig>
    <!-- 注意：框架 <params> 段格式为 元素名作 key + value 属性（如 <maxParallel value="5"/>），
         不是 <param name="..." value="..."/>（后者会被解析器当成 key="param" 反复覆盖，静默失效） -->
    <params>
        <maxParallel value="5"/>
        <description value="诗歌创作工作流：两个不同风格诗人并行创作后汇总"/>
        <!-- 表达式模式（可选替代 <nodes>/<edges>）：语法与规则详见文件头"六、表达式模式" -->
        <expression value="(poetA &amp;&amp; poetB) -> poetc"/>
    </params>

    <!-- 工作流自有的私有模块——每个节点一个独立实例。
         noHistory="true"：不往 context 存/取会话消息（每次白纸，提示词不膨胀、速度稳定）；
         sessionId 照常继承父会话（级联停止/会话链不受影响）。
         需要"接着上次"连续性的节点去掉该参数即可 -->
    <modules>
        <module name="poetA" sameClassAs="aiagent"
                defaultLlmProvider="aiagent_master:openAiProvider"
                noHistory="true"
                systemMessage="你是一个浪漫主义诗人，请用简洁优美的语言回应用户。"
                temperature="0.9"/>
        <module name="poetB" sameClassAs="aiagent"
                defaultLlmProvider="aiagent_master:openAiProvider"
                noHistory="true"
                systemMessage="你是一个现实主义诗人，请用朴实深刻的语言回应用户。"
                temperature="0.7"/>
        <!-- poetc 的工具（filesystemMcp MCP）声明在其自己的配置文件 poetc_config.xml 的
             <agents> 段（factoryShared 共享主工厂实例）——工具模块不能作为工作流节点。
             task 参数：通用 agent 参数，固定任务前缀（systemMessage 管人设，task 管工作） -->
        <module name="poetc" sameClassAs="aiagent"
                configfile="poetc_config.xml"
                defaultLlmProvider="aiagent_master:openAiProvider"
                noHistory="true"
                systemMessage="你是诗歌评判专家，只输出分析和评判，禁止创作新诗。"
                task="请对以上两首诗进行对比分析和评判"
                />
    </modules>

    <!-- 节点定义：id = <modules> 中的模块名 -->
    <!--nodes>
        <node id="input" type="fanout" />
        <node id="poetA" type="agent" action="chat"/>
        <node id="poetB" type="agent" action="chat"/>
        <node id="merge" type="join" />
    </nodes-->

    <!-- 边定义 -->
    <!--edges>
        <edge from="input" to="poetA" />
        <edge from="input" to="poetB" />
        <edge from="poetA" to="merge" />
        <edge from="poetB" to="merge" />
    </edges-->
</moduleConfig>
