<?xml version="1.0" encoding="UTF-8" ?>
<moduleConfig>
    <params>
        <!-- ===== 工具执行超时控制 =====
             executionTimeoutMs: 单次工具执行超时（毫秒），0 = 一直等待。
                 注意：LLM 的 tool-call 循环另有 maxToolCallIterations 限制，此参数只限单次工具执行。

             staleStateTimeoutMs: 残留状态清理阈值（毫秒），0 = 禁用。
                 只清理"等待线程已消失"的泄漏状态：超过此时间且调用 executeTools 的线程
                 已结束，才在下次工具执行入口扫描时强制终止（abort + 释放等待者）。
                 调用线程仍存活 = 正在合法等待，不会被清理——委派子 agent 等长任务可以
                 超过 10 分钟（2026-10-22 codingAgent 委派 601s 被按年龄误杀后改为按存活判定）。
                 注意：正等人工审批的执行仍不会被它清理（approvalWaiters 守卫，2026-10-16），
                 审批等待是设计语义内的合法长跑（approvalTimeoutMs=0 可无限）。
                 带审批的技能应配 timeout=0（不再用工具超时兜审批窗口）。
                 单次工具执行的时长上限请用 executionTimeoutMs（0 = 不限）。 -->
        <executionTimeoutMs value="0"/>
        <staleStateTimeoutMs value="600000"/>
        <!-- 审批门禁：共享执行器的全局配置。规则按工具名匹配（file_operation:delete/write 等
             危险工具只在子 agent 上，天然审批下沉）；会话/用户隔离由审批请求消息携带的
             sessionId/userId 保证。不配置 = 全应用不启用审批。 -->
        <approvalModule value="approvalGate"/>
        <!-- 路径守卫：workspace/{userId} 外读写需审批、跨用户直接拒绝。
             开启时，所有在 TLUserWorkspace.PATH_ARGS 登记的工具（file_operation/word）
             必须同时配置 workspaceMode="true"；只开守卫不开 workspaceMode 属于
             fail-open 的错误配置（技能仍写旧根，守卫却按 workspace 判定）。
             未配置 approvalModule 时守卫会 WARN；越界路径的 NEED_APPROVAL 退化为放行
             （未配置审批 = 功能未启用），跨用户仍硬拒绝。 -->
        <pathGuard value="true"/>
        <!-- 工具输出客观校验：规则见 outputValidator_config.xml；不配置 = 不校验 -->
        <outputValidator value="outputValidator"/>
    </params>
    <beforeMsgTable>
        <action name="toolExecBatch">
            <msg action="authForBatch" destination="appAuthModule" />
        </action>
    </beforeMsgTable>
    <afterMsgTable>
        <action name="toolExecBatch">
            <msg action="fillDenied" destination="appAuthModule" />
        </action>
    </afterMsgTable>
</moduleConfig>
