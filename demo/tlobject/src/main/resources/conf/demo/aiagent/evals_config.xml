<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <params>
        <!-- 评测用例目录 -->
        <evalCaseDir value="conf/demo/aiagent/evals/cases/"/>

        <!-- 报告输出目录 -->
        <reportOutputDir value="data/evals/reports/"/>

        <!-- 目标 Agent 模块名 -->
        <targetAgent value="aiagent_master"/>

        <!-- LLM-as-Judge 使用的 Provider -->
        <judgeProvider value="myopenAiProvider"/>

        <!-- 裁判调用用的推理模式：disabled(默认) 显式关推理 | off 不显式开启 | native | auto。
             裁判只要吐一个短 JSON，推理会抢 max_tokens——被吃光时 content 是空串，
             "判决"其实成了模型的内心独白，用例白白变红。provider 不接受 thinking 字段时设 off -->
        <judgeReasoningMode value="disabled"/>

        <!-- 上下文模块（用于提取 tool calls） -->
        <contextModule value="aiContext"/>

        <!-- 是否与上一次报告对比（回归检测）：每跑一次就把"新挂了哪几条"标出来 -->
        <compareBaseline value="true"/>

        <!-- 指定基准报告（可选）：文件名或路径；留空则自动取报告目录里最近一份 -->
        <baselineFile value=""/>

        <!-- 门禁：通过率阈值 + 允许的回归数上限。
             这里只开回归门禁（上限 0），不设通过率阈值——不要求先把已有失败清干净，
             只要求"不许出现新回归"。等套件稳定了再考虑加 gatePassRate。 -->
        <!-- <gatePassRate value="0.9"/> -->
        <gateMaxRegressions value="0"/>
    </params>
</moduleConfig>
