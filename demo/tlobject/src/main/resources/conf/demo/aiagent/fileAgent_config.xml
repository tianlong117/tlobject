<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <!-- ===== 文件处理子Agent配置 ===== -->
    <!-- 只有文件相关skill，无<agents> → 独立/叶子Agent模式 -->

    <params>
        <defaultLlmProvider value="aiagent_master:openAiProvider"/>
        <defaultSkillPackageName value="cn.tianlong.tlobject.aiagent.skill.builtin"/>
        <defaultMemoryPackageName value="cn.tianlong.tlobject.aiagent.memory"/>
        <!-- HITL 审批 -->
        <approvalModule value="approvalGate"/>
    </params>
    <!--providers>
        <provider name="openAiProvider"
                  sameClassAs="openAiProvider"
                  statup="true"
                  apiKey="sk-your-api-key"
                  apiBaseUrl="https://api.deepseek.com"
                  defaultModel="deepseek-v4-flash"/>
    </providers-->
    <agents>
        <!-- MCP Agent 示例：本地文件系统工具集 -->
        <agent name="filesystemMcp"
               statup="true"
               factoryShared="true"
               type="mcp"
               tools="read_file,write_file,list_directory"
               description="MCP文件系统工具集（仅暴露3个常用操作）"
               sameClassAs="mcpAgent"
               transport="stdio"
               command="C:/Program Files/nodejs/npx.cmd"
               args="-y @modelcontextprotocol/server-filesystem D:/tlobjectapp/tlobject"/>


    </agents>
    <skills>
        <skill name="fileOperationSkill"
               sameClassAs="fileOperationSkill"
               statup="true"
               skillName="file_operation"
               skillDescription="Read and write files on the local filesystem. Operations: read, write, list, exists, delete."/>
    </skills>

    <memoryStores>
        <memoryStore name="longTermMemory"
                     sameClassAs="longTermMemory"
                     statup="true"
                     memoryType="longTerm"
                     maxCacheEntries="10000"/>
    </memoryStores>
    <afterMsgTable>
        <action name="chat" >
            <dmsg action="reviewChat" destination="errorSupervisor" maxReviewRounds="2"/>
        </action>
    </afterMsgTable>
</moduleConfig>
