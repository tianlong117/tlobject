<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <!-- ===== 询价组监理Agent（supervisor） =====
         priceTeam 组内监理：审核汉堡/披萨报价并汇总统一报价单。
         审核标准与输出要求在 md/priceReviewer.md（loadAgentMd 自动加载为 system prompt），
         retry JSON 输出契约由组在审核消息里携带，此处无需配置。无 skills。 -->

    <params>
        <defaultLlmProvider value="aiagent_master:openAiProvider"/>
        <!-- 关思考：DeepSeek thinking 模式要求 assistant 的 reasoning_content 必须回传（旧 Provider 不回传会在工具回合后 400）；任务类 agent 预算留给正文 -->
        <reasoningMode value="disabled"/>
        <maxToolCallIterations value="3"/>
    </params>
</moduleConfig>
