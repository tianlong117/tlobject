<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <!-- ===== 代码执行子Agent配置 ===== -->
    <!-- 内置 code_execution + script_execution 两个技能 -->

    <params>
        <defaultLlmProvider value="openAiProvider"/>
        <defaultSkillPackageName value="cn.tianlong.tlobject.aiagent.skill.builtin"/>
        <defaultMemoryPackageName value="cn.tianlong.tlobject.aiagent.memory"/>
        <!-- HITL 审批由共享执行器全局启用（toolExecutor_config.xml），规则按工具名匹配 -->
        <!-- 不走意图缓存：带审批门禁的工具操作不得被学习/命中缓存 -->
        <intentCache value="false"/>
    </params>

    <providers>
        <provider name="openAiProvider"
                  sameClassAs="openAiProvider"
                  statup="true"
                  apiKey="sk-your-api-key"
                  apiBaseUrl="https://api.deepseek.com"
                  defaultModel="deepseek-v4-flash"/>
    </providers>

    <skills>
        <skill name="codeExecutionSkill"
               sameClassAs="codeExecutionSkill"
               statup="true"
               skillName="code_execution"
               skillDescription="Execute inline code snippets in Python or JavaScript."/>

        <skill name="scriptExecutionSkill"
               sameClassAs="scriptExecutionSkill"
               statup="true"
               skillName="script_execution"
               skillDescription="Execute an existing script file (.py, .sh, .js etc.) and return its output."/>
    </skills>

    <memoryStores>
        <memoryStore name="longTermMemory"
                     sameClassAs="longTermMemory"
                     statup="true"
                     memoryType="longTerm"
                     maxCacheEntries="10000"/>
    </memoryStores>
</moduleConfig>
