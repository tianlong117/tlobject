<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <!-- ===== 代码执行子Agent配置 ===== -->
    <!-- 内置 code_execution + run_script 两个技能 -->

    <params>
        <!-- 借主控 Provider：避免子 agent 自建一份 DeepSeek 实例（启动时多余的初始化） -->
        <defaultLlmProvider value="aiagent_master:openAiProvider"/>
        <!-- 关思考：DeepSeek thinking 模式要求 assistant 的 reasoning_content 必须回传（旧 Provider 不回传会在工具回合后 400）；任务类 agent 预算留给正文 -->
        <reasoningMode value="disabled"/>
        <defaultSkillPackageName value="cn.tianlong.tlobject.aiagent.skill.builtin"/>
        <defaultMemoryPackageName value="cn.tianlong.tlobject.aiagent.memory"/>
        <!-- defaultMaxTokens: 单次 LLM 回复输出上限。生成脚本/大文件时正文装在代码参数里，
             4096 写长脚本会被截断（实测连撞 3 次 4096 后耗尽迭代）；8192 减半往返次数。
             子 agent 调用不走主 agent 的 maxTokens（executeAsTool 不透传），此处生效 -->
        <defaultMaxTokens value="8192"/>
        <!-- maxToolCallIterations: 单轮 LLM tool-call 循环上限。默认 10 对"写脚本→跑→看报错→改→再跑"
             这类核验任务偏紧，与 fileAgent 对齐为 30；需要完整调试循环的任务仍优先 codingAgent（40）。 -->
        <maxToolCallIterations value="30"/>
        <!-- HITL 审批由共享执行器全局启用（toolExecutor_config.xml），规则按工具名匹配 -->
        <!-- 不走意图缓存：带审批门禁的工具操作不得被学习/命中缓存 -->
        <intentCache value="false"/>
    </params>

    <!-- 借主控 Provider（aiagent_master:openAiProvider）；如需独立 key/模型再解注释，
         并把 defaultLlmProvider 改回 openAiProvider
    <providers>
        <provider name="openAiProvider"
                  sameClassAs="openAiProvider"
                  statup="true"
                  apiKey="sk-your-api-key"
                  apiBaseUrl="https://api.deepseek.com"
                  defaultModel="deepseek-v4-flash"/>
    </providers-->

    <skills>
        <skill name="codeExecutionSkill"
               sameClassAs="codeExecutionSkill"
               statup="true"
               skillName="code_execution"
               workspaceMode="true"
               skillDescription="Execute inline code snippets in Python or JavaScript. Python stdout is UTF-8; when reading files, pass the correct encoding to open() (e.g. encoding='gbk' for GBK files)."/>

        <!-- allowedScriptDir 必须显式配成 workspace 的绝对路径：默认 "." 在 scriptExecutionSkill 里
             按**配置目录**（target/classes/conf/…）解析，workspace 脚本会在 CWD 切换逻辑之前
             就被判"outside allowed directory"；配绝对路径后 workspace/{userId} 内的脚本可用。
             发布版不写死机器路径：需要执行 workspace 内脚本时，请自行加
             allowedScriptDir="/你的项目根/workspace"。 -->
        <skill name="scriptExecutionSkill"
               sameClassAs="scriptExecutionSkill"
               statup="true"
               skillName="run_script"
               workspaceMode="true"
               skillDescription="Execute an existing script file (.py, .sh, .js etc.) and return its output."/>
    </skills>

    <memoryStores>
        <memoryStore name="longTermMemory"
                     sameClassAs="longTermMemory"
                     statup="true"
                     memoryType="longTerm"
                     maxCacheEntries="10000"/>
    </memoryStores>
</moduleConfig>
