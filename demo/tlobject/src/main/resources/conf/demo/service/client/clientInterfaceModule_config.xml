<?xml version="1.0" encoding="UTF-8" ?>
<moduleConfig>
    <params>
        <ifAutoConnect value ="false" />
        <defaultServer value="clientSocketServe0" />
    </params>
    <msgTable>
        <msgid  value="receiveBinaryFile"  >
            <msg  destination="webSocketReceiveFileModule" action="receiveBinaryFile" msgTableUseType="useMsg" />
        </msgid>
        <msgid  value="receiveBinary"   >
            <msg   action="receiveBinary" msgTableUseType="useMsg" />
        </msgid>
        <msgid  value="fromServerWife" >
            <msg  destination="xiaoming" action="cook" />
        </msgid>
        <msgid  value="receiveFileFromServer" >
            <msg  destination="clientModule" action="receiveFileFromServer" />
        </msgid>
        <msgid  value="getFileByServer" >
            <msg  destination="clientModule" action="getFileByServer" />
        </msgid>
    </msgTable>
    <servers>
        <!-- 如设定cerFile ，并且协议为wss 则启动ssl传输  -->
        <server name="server0"  userType="username"  cerFile__="/mycerts.cer"
                url="ws://127.0.0.1:9081/ws" userName="demo_user" userPasswd="12345"  autoConnect="false"  />
    </servers>

</moduleConfig>