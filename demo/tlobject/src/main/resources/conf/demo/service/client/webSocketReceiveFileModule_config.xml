<?xml version="1.0" encoding="UTF-8" ?>
<moduleConfig>
    <params>
        <msgHandler value="clientInterfaceModule"  />
        <fileSessionPoolName value="reUsedSingleThreadPoolGroup" />
        <filePath   value="data/wsclient/" />
        <maxSessions   value="100" />
    </params>
    <modulesParams>
        <module name="reUsedSingleThreadPoolGroup"
                initModuleNumbs="50"
                maxModuleNumbs="100"
                waitPoolTime="8000"
                maxUserNumber="5000"/>
    </modulesParams>
    <msgTable>
        <msgid  value="startPutFile" >
            <msg  destination="clientInterfaceModule" action="putToAndWait" msgTableUseType="useMsg" />
        </msgid>
        <msgid  value="sendFile" >
            <msg  destination="clientInterfaceModule" action="sendFile" msgTableUseType="useMsg"/>
        </msgid>
        <msgid  value="endFile" >
            <msg  destination="clientInterfaceModule" action="putMsgToSocket" msgTableUseType="useMsg" />
        </msgid>
        <msgid  value="getFile" >
            <msg  destination="clientInterfaceModule" action="putMsgToSocket" msgTableUseType="useMsg" />
        </msgid>
        <msgid  value="sendBinary" >
            <msg  destination="clientInterfaceModule" action="sendBinary" msgTableUseType="useMsg" />
        </msgid>
        <msgid  value="returnAppResult" >
            <msg  destination="clientInterfaceModule"  sesstionType="client" action="putMsgToSocket" msgTableUseType="useMsg" />
        </msgid>
    </msgTable>

</moduleConfig>