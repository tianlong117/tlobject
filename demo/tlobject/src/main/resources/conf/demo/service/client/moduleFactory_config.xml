        <module name="wife" proxyModule="socketClientAgentPool" configfile="socketClientAgentPool_config.xml" />
        <module name="soceketClientThreadPool" proxyModule="fixedThreadPool" poolSize="100" />
    </modules>
        <factoryBoot>
            <msg action="getModule"  moduleName="threadPool" usePreReturnMsg="false" />
        </factoryBoot>
</moduleConfig>