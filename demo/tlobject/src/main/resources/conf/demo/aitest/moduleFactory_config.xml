<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <!-- 引入框架核心模块定义 -->
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.modules_config.xml" includeUnit="modules"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.network_config.xml" includeUnit="modules"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.db_config.xml" includeUnit="modules"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.aiagent_config.xml" includeUnit="modules"/>

    <params>
        <!-- 应用标识 -->
        <applicationId value="aiagentDemo"/>

        <!-- 日志配置 -->
        <ifLog value="true"/>
        <loglevel value="DEBUG"/>
        <logWait value="true"/>
        <defaultLogModule value="log4j"/>
        <!-- 模块监控（关闭以提高性能） -->
        <ifModuleMonitor value="false"/>

        <!-- Demo Java包前缀 -->
        <package value="cn.tianlong.java.demo.aiagent"/>
    </params>

    <modulesParams>
        <module name="aiContext" defaultSystemMessage="你是一个有用的AI助手，可以使用工具来帮助用户完成任务。请用简洁清晰的语言回答问题。"/>
    </modulesParams>

    <modules>
        <!-- 主测试模块 -->
        <module name="aiAgentDemo"
                classfile=".AiAgentDemoModule"
                configfile="CLASSPATH/conf/demo/aitest/aiagent_demo_config.xml"
                singleton="true"/>

        <!-- DAG工作流模块 -->
        <module name="demoWorkflow"
                classfile="cn.tianlong.tlobject.aiagent.workflow.TLAgentWorkflow"
                configfile="CLASSPATH/conf/demo/aitest/demoWorkflow_config.xml"/>

        <!-- Demo 用户信息模块：XML 配置 userId → role/group -->
        <module name="demoUserModule"
                classfile="cn.tianlong.java.demo.aiagent.DemoUserModule"
                singleton="true"
                users="default:member;admin:member,admin;guest:guest"
                groups="admin:0" />

        <!-- 意图缓存测试实例（borrowDelegate 直接借用工厂 mockProvider 单例，共享测试队列） -->
        <module name="testCacheProvider"
                classfile="cn.tianlong.tlobject.aiagent.TLIntentCacheProvider"
                borrowDelegate="true"
                delegateProvider="mockProvider"/>

        <!-- 评测用的 LLM 裁判 Provider。
             框架注册表里那个裸名 openAiProvider 只有类、没有凭据（凭据是每个应用自己配的），
             直接拿它当 judgeProvider 会在拼请求时因 url 为空抛 NPE。
             agent 的子模块（aiagent:openAiProvider）够不着——TLLlmJudge 按名寻址、不做家族名解析。
             所以照 chat 应用的 myopenAiProvider 写法，自己声明一个带凭据的。 -->
        <module name="myopenAiProvider" sameClassAs="openAiProvider"
                statup="true"
                apiKey="sk-your-api-key"
                apiBaseUrl="https://api.deepseek.com"
                defaultModel="deepseek-v4-flash"
                connTimeOut="30"
                readTimeOut="120"/>

    </modules>

    <!-- ===== 工厂启动序列 ===== -->
    <factoryBoot>
        <!-- 先获取日志模块 -->
        <msg action="getModule" destination="moduleFactory" moduleName="logThreadPool"/>

        <!-- 获取AI Agent核心模块（触发初始化） -->
        <msg action="getModule" destination="moduleFactory" moduleName="aiagent"/>
        <msg action="getModule" destination="moduleFactory" moduleName="aiContext"/>
        <msg action="getModule" destination="moduleFactory" moduleName="sessionManager"/>

        <!-- 获取内置模块 -->
        <msg action="getModule" destination="moduleFactory" moduleName="openAiProvider"/>
        <!-- 评测裁判用的（带凭据）——启动即实例化，配错了在启动时就能看见 -->
        <msg action="getModule" destination="moduleFactory" moduleName="myopenAiProvider"/>
        <msg action="getModule" destination="moduleFactory" moduleName="httpRequestSkill"/>
        <msg action="getModule" destination="moduleFactory" moduleName="fileOperationSkill"/>
        <msg action="getModule" destination="moduleFactory" moduleName="shortTermMemory"/>
        <msg action="getModule" destination="moduleFactory" moduleName="longTermMemory"/>

        <!-- 获取Demo测试模块和工作流模块 -->
        <msg action="getModule" destination="moduleFactory" moduleName="aiAgentDemo"/>
        <msg action="getModule" destination="moduleFactory" moduleName="demoWorkflow"/>
        <msg action="getModule" destination="moduleFactory" moduleName="agentMonitor"/>
        <msg action="getModule" destination="moduleFactory" moduleName="streamCallback"/>

        <!-- 获取监管Agent -->
        <msg action="getModule" destination="moduleFactory" moduleName="errorSupervisor"/>

        <!-- 获取审批模块（可选，启用审批时解注） -->
        <!-- <msg action="getModule" destination="moduleFactory" moduleName="approvalGate"/> -->

        <!-- 获取认证模块和桥接模块 -->
        <msg action="getModule" destination="moduleFactory" moduleName="auth"/>
        <msg action="getModule" destination="moduleFactory" moduleName="appAuthModule"/>
        <msg action="getModule" destination="moduleFactory" moduleName="demoUserModule"/>

        <!-- 获取评测模块 -->
        <msg action="getModule" destination="moduleFactory" moduleName="evals"/>

        <!-- 获取测试模块 -->
        <msg action="getModule" destination="moduleFactory" moduleName="mockProvider"/>
        <msg action="getModule" destination="moduleFactory" moduleName="testEchoSkill"/>
        <msg action="getModule" destination="moduleFactory" moduleName="testSleepSkill"/>
        <msg action="getModule" destination="moduleFactory" moduleName="agentTestModule"/>

        <!-- 触发 Mock Provider 单元测试 -->
        <msg action="runAllTests" destination="agentTestModule"/>
    </factoryBoot>
</moduleConfig>
