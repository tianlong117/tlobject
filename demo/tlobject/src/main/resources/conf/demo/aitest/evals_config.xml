<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <params>
        <!-- 评测用例目录 -->
        <evalCaseDir value="conf/demo/aitest/evals/cases/"/>

        <!-- 报告输出目录 -->
        <reportOutputDir value="data/evals/reports/"/>

        <!-- 目标 Agent 模块名 -->
        <targetAgent value="aiagent"/>

        <!-- LLM-as-Judge 使用的 Provider -->
        <judgeProvider value="openAiProvider"/>

        <!-- 上下文模块（用于提取 tool calls） -->
        <contextModule value="aiContext"/>

        <!-- 是否与上一次报告对比（回归检测）：每跑一次就把"新挂了哪几条"标出来 -->
        <compareBaseline value="true"/>

        <!-- 指定基准报告（可选）：文件名或路径；留空则自动取报告目录里最近一份 -->
        <baselineFile value=""/>
    </params>
</moduleConfig>
