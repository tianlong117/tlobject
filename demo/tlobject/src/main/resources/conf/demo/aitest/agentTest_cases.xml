<?xml version="1.0" encoding="UTF-8"?>
<testCases>
    <!--
        ===== 自定义测试用例配置 =====

        格式说明:
          <case name="用例名">
            <mock>                         ← 预设 Mock Provider 响应（按顺序消耗）
              <response                     ← 单次 LLM 响应
                result="true|false"         ← RESULT 字段（默认 true）
                aiResponse="文本"           ← AI 回复内容
                hasToolCalls="true"         ← 是否包含工具调用
                error="错误信息"/>           ← result=false 时的错误信息
                <toolCall                   ← 工具调用（需 hasToolCalls="true"）
                  id="call_1"               ← tool call ID
                  function="函数名"          ← LLM 函数名
                  args='{"key":"val"}'/>    ← 参数 JSON
              </response>
            </mock>
            <chat                            ← 发送的 chat 消息
              targetAgent="aiagent"          ← 目标 Agent 模块名（默认 aiagent）
              userMessage="用户输入"          ← 用户消息
              sessionId="唯一会话ID"          ← 会话 ID
              model="模型名"                  ← 可选：模型
              temperature="0.7"              ← 可选：温度
              maxIterations="10"/>           ← 可选：最大迭代
            <assert                          ← 断言（全部匹配才通过）
              result="true"                  ← RESULT 期望值
              aiResponseContains="应包含"     ← AI 回复应包含的文字
              aiResponseNotContains="不应含"  ← AI 回复不应包含的文字
              minIterations="1"              ← 最少迭代轮次
              maxIterations="5"/>            ← 最多迭代轮次
          </case>

        内置 echo/sleep 测试 Skill:
          函数名: test_echo  → 回显输入
          函数名: test_sleep → 按 duration 毫秒阻塞
    -->

    <!-- ===== 示例1：测默认 Agent 纯文本 ===== -->
    <case name="示例-默认Agent基本问答">
        <mock>
            <response result="true" aiResponse="你好！我是AI助手，有什么可以帮助你的？"/>
        </mock>
        <chat targetAgent="aiagent" userMessage="你好" sessionId="case_hello"/>
        <assert result="true" aiResponseContains="AI助手"/>
    </case>

    <!-- ===== 示例2：测指定 Agent ===== -->
