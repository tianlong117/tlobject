2. [ ] 预订酒店
3. [ ] 预订机票"/>
        </mock>
        <chat targetAgent="planTask" userMessage="帮我规划北京到上海的旅行"/>
        <assert result="true" aiResponseContains="预订"/>
    </case>
    -->

