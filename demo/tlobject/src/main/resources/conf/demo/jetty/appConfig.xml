<?xml version="1.0" encoding="UTF-8" ?>
<appConfig>
    <params>
        <name    value="demo"/>
        <verison value="1"/>
        <charset value="text/html;charset=utf-8"/>
        <!-- 框架url路径  与过滤器中配置一致-->
        <tlobjectPath value="/demo"/>
        <!-- 默认用户类 -->
        <defaultClientUser value="webUser" />
    </params>
    <!-- 消息路由表-->
    <msgTable>
        <msgid  value="setup" >
            <msg action="getModule" destination="moduleFactory" moduleName="volecity"/>
        </msgid>
    </msgTable>
    <!-- 初始运行消息表-->
    <initMsg>
        <!-- 启动日志，根据msgtable 动态加入监听对象-->
        <!--msg action="startLogOnRun" destination="msglog" useInputMsg="false" usePreReturnMsg="false"/ -->

</initMsg>
    <!-- 方法运行前执行消息表-->

    <beforeMsgTable>
        <!-- 网站启动、关闭管理模块   -->
        <action  value="start" >
            <msg   action="setup" destination="website"  useInputMsg="false" usePreReturnMsg ="false" ></msg>
        </action>
    </beforeMsgTable>
    <afterMsgTable>
        <action  value="start" >
            <msg   action="end" />
        </action>
    </afterMsgTable>

</appConfig>