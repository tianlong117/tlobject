<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.modules_config.xml" includeUnit="modules"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.network_config.xml" includeUnit="modules"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.db_config.xml" includeUnit="modules"/>
    <params>
        <applicationId value="chatDemo"/>
        <ifLog value="true"/>
        <logWait value="false" />
        <loglevel value="debug"/>
        <defaultLogModule value="log4j"/>

    </params>
    <commonParams>
        <ifLog value="true"/>
        <logWait value="false" />
        <loglevel value="trace"/>
    </commonParams>
    <modules>
        <!-- ====== UniAgent 核心模块 ====== -->
        <module name="uniagent"
                classfile="cn.tianlong.tlobject.uniagent.UniAgent"
                configfile="uniagent_config.xml"
                singleton="true"/>

        <module name="toolFactory"
                classfile="cn.tianlong.tlobject.uniagent.ToolFactory"
                configfile="toolFactory_config.xml"
                singleton="true"/>

        <module name="toolExecutionEngine"
                classfile="cn.tianlong.tlobject.uniagent.ToolExecutionEngine"
                singleton="true"/>

        <!-- ====== Provider 和 Context ====== -->
        <module name="openAiProvider"
                classfile="cn.tianlong.tlobject.uniagent.TLOpenAiProvider"
                singleton="true"/>

        <module name="aiContext"
                classfile="cn.tianlong.tlobject.uniagent.TLAiContext"
                singleton="true"/>

        <!-- ====== Demo 工具模块 ====== -->
        <module name="echoTool"
                classfile="cn.tianlong.java.demo.uniagent.tools.DemoEchoTool"
                singleton="true"/>

        <module name="calculatorTool"
                classfile="cn.tianlong.java.demo.uniagent.tools.DemoCalculatorTool"
                singleton="true"/>

        <!-- ====== 子 Agent (另一个 UniAgent 实例，演示委托) ====== -->
        <module name="assistantAgent"
                classfile="cn.tianlong.tlobject.uniagent.UniAgent"
                configfile="assistant_config.xml"
                singleton="true"/>
    </modules>

    <modulesParams>
        <!-- UniAgent 核心参数 -->
        <module name="uniagent"
                llmProvider="openAiProvider"
                contextModule="aiContext"
                toolFactory="toolFactory"
                toolEngine="toolExecutionEngine"
                systemMessage="你是一个友好的AI助手，名叫 UniAgent。你可以使用工具来帮助用户解决问题。如果用户要求做计算，使用 calculatorTool。如果用户要求回显文本，使用 echoTool。如果任务比较复杂，可以委托给 assistantAgent。请用中文回复。"
                defaultModel="deepseek-chat"
                defaultTemperature="0.7"
                defaultMaxTokens="4096"
                maxToolCallIterations="10"/>

        <!-- TLOpenAiProvider 参数 (DeepSeek API) -->
        <module name="openAiProvider"
                apiKey="sk-your-api-key-here"
                apiBaseUrl="https://api.deepseek.com"
                defaultModel="deepseek-chat"/>

        <!-- 子 Agent 使用同一个 Provider -->
        <module name="assistantAgent"
                llmProvider="openAiProvider"
                contextModule="aiContext"
                toolFactory="toolFactory"
                toolEngine="toolExecutionEngine"
                systemMessage="你是 UniAgent 的助手。你擅长执行具体任务。请简洁高效地完成任务并返回结果。"
                defaultModel="deepseek-chat"
                defaultTemperature="0.5"
                maxToolCallIterations="5"/>
    </modulesParams>

    <factoryBoot>threadPool
        <msg action="getModule" destination="moduleFactory" moduleName="logThreadPool"/>
        <msg action="getModule" destination="moduleFactory" moduleName="threadPool"    usePreReturnMsg="false" />
        <msg action="getModule" destination="moduleFactory" moduleName="openAiProvider"/>
        <msg action="getModule" destination="moduleFactory" moduleName="aiContext"/>
        <msg action="getModule" destination="moduleFactory" moduleName="toolFactory"/>
        <msg action="getModule" destination="moduleFactory" moduleName="toolExecutionEngine"/>
        <msg action="getModule" destination="moduleFactory" moduleName="uniagent"/>
    </factoryBoot>
</moduleConfig>
