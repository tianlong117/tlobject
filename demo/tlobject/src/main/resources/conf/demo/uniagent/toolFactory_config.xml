<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <!-- ToolFactory 的工具列表在 uniagent_config.xml 中定义 -->
    <!-- 这里保持空配置，ToolFactory 的 initTools() 会从自身 mconfig 读取 <tools> -->
    <tools>
        <!-- sameClassAs: 复用工厂 <modules> 中同名模块的 class 定义，遵循 aiagent skill/agent 配置模式 -->
        <tool name="echoTool" sameClassAs="echoTool" enabled="true" statup="true"/>
        <tool name="calculatorTool" sameClassAs="calculatorTool" enabled="true" statup="true"/>
        <tool name="assistantAgent" sameClassAs="assistantAgent" enabled="true" statup="true"/>
    </tools>
</moduleConfig>
