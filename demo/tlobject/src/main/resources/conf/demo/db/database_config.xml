<?xml version="1.0" encoding="UTF-8" ?>
<moduleConfig>
    <params>
        <verison value="1"/>
        <defaultDBserver value="dbserver1" />
        <dbPackageName value="cn.tianlong.java.demo.db" />
    </params>
    <dbservers>
        <dbserver name="dbserver1"             proxyModule="dbserver"
                  driver="com.mysql.jdbc.Driver"
                  dburl="jdbc:mysql://127.0.0.1:3306/weishengju?characterEncoding=utf8"
                  dbuser="root" dbpass="123456"
                  connector="c3p0Conn"
                  initPoolSize="5" maxPoolSize="100" maxIdleTime="60" />
        <dbserver name="dbserver2"             proxyModule="dbserver"
                  driver="com.mysql.jdbc.Driver"
                  dburl="jdbc:mysql://127.0.0.1:3306/test?characterEncoding=utf8"
                  dbuser="root" dbpass="123456"
                  connector="c3p0Conn"
                  initPoolSize="5" maxPoolSize="100" maxIdleTime="60" />
    </dbservers>
    <tables>

        <table name="userTable"  dbtable="user"  dbserver="dbserver2" beforeTrigger="userTableSplitTrigger"  classfile="" />
        <table name="userTable1" dbtable="userm"  dbserver="dbserver1" />
        <table name="userTable2" dbtable="userw"  dbserver="dbserver2" />
    </tables>
    <views>
        <view name="adminmenue"   dbserver="qqmanager"
              sql="select  m.* ,u.href from  menus m  left outer join urls u on m.urlid =u.id order by pid, sort" />
        <view name="vusers"  sql="select * from user where number < ?" dbserver="dbserver1" resultType="arrayList"
              cacheName="vusers" beforeTrigger="cachetrigger"
              afterTrigger="aftercachetrigger"/>
        <view name="vmessages"  sql="select * from messages" dbserver="dbserver2" />
     </views>
    <triggers>
        <trigger name="tableCacheBefore"    query="getCacheBeforeModle"  />
        <trigger name="tableCacheAfter"    query="writeCacheAfterModle"  update="deleteCacheAfterModle" delete="deleteCacheAfterModle" />
        <trigger name="userTableSplitTrigger"  tableName="userTable" splitTables="userTable1;userTable2" splitKey="name"
                 delete="onDelete"  insert="onInsert" query="onQuery"  update="onUpdate"
                 classfile=".UserTableSplitTrigger" />
    </triggers>
</moduleConfig>