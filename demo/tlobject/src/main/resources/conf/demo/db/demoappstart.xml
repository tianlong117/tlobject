<?xml version="1.0" encoding="UTF-8" ?>
<appConfig>
    <startMsg>
        <!-- 演示各种不同的数据库表操作。
           为偷懒，通过设置在action前增加#来不运行该动作, 因为模块没有该动作。
          实际应用中还是通过xml语法注释掉,因为通过命名不存在的动作，虽然没有运行该动作，但是模块要运行该动作的前后其他准备。
        -->
        <msg action="#initDataTb"  destination="dbDemo" />
        <msg action="#insertTb"     destination="dbDemo"   username="siren" number="99999999" />
        <msg action="queryByTable"  username="dong1"/>
        <msg action="#queryResultIsBean" destination="dbDemo" username="dong"/>
        <msg action="#updateByTable"  username="dong1" number="7777"/>
        <msg action="#deleteByTable"  username="dong2"/>
        <msg action="#dbBean"    destination="dbDemo"    />
        <msg action="#dbview"    destination="dbDemo"   username="dong" waitFlag="false" />
        <msg action="#dbview"    destination="dbDemo"   username="dong" waitFlag="false"/>
        <msg action="#dbview"    destination="dbDemo"   username="dong" waitFlag="false"/>
        <msg action="#dbview"    destination="dbDemo"   username="dong" waitFlag="false"/>
        <msg action="#dbview"    destination="dbDemo"   username="dong" waitFlag="false"/>
        <!-- 第二次使用缓存 -->
        <msg action="#sleep" sleepTime="20000"/>
        <msg action="#dbview"    destination="dbDemo"   username="dong" />
        <msg action="queryTb"    destination="userModle"   username="dong" />
        <msg action="#transactionByDB"   destination="dbDemo"  names="dong777;wang999" />
        <msg action="#queryByTable"  username="dddd3"/>
        <msg action="#queryByTable"  username="yyyy5"/>
        <msg action="#clearTb"    destination="dbDemo"    />
    </startMsg>
</appConfig>