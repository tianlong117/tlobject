<?xml version="1.0" encoding="UTF-8" ?>
<appConfig>
    <startMsg>
        <!-- 演示各种不同的数据库表操作。
           为偷懒，通过设置在Dmsg前增加 D 来不运行该动作, 因为Dmsg 不被解析为消息Dmsg。
          实际应用中还是通过xml语法注释掉,因为通过命名不存在的动作，虽然没有运行该动作，但是模块要运行该动作的前后其他准备。
        -->
        <Dmsg action="initDataTb"  destination="dbDemo" />
        <Dmsg action="isTableExist"  destination="dbDemo" tableName="user22"/>
        <Dmsg action="batch"  destination="userTableModle" /> //批量插入数据
        <Dmsg action="insertTb"     destination="dbDemo"   username="siren" number="99999999" />
        <Dmsg action="queryByUserName"  username="dong1"/>  根据username分表，分表查询
        <Dmsg action="queryByNumber"   number="3" ifCache="true"/>    //  不通过分表键，所有表并行查询，查询进行缓存
        <Dmsg action="queryResultIsBean" destination="dbDemo" username="dong"/>
        <Dmsg action="updateByTable"  username="dong1" number="7777"/>
        <Dmsg action="deleteByTable"  username="dong2"/>
        <Dmsg action="dbBean"    destination="dbDemo"   username="同桌1991" number="2024"  />
        <Dmsg action="dbview"    destination="dbDemo"   username="dong" waitFlag="false" />
        <Dmsg action="dbview"    destination="dbDemo"   username="dong" waitFlag="false"/>
        <Dmsg action="dbview"    destination="dbDemo"   username="dong" waitFlag="false"/>
        <Dmsg action="dbview"    destination="dbDemo"   username="dong" waitFlag="false"/>
        <Dmsg action="dbview"    destination="dbDemo"   username="dong" waitFlag="false"/>
        <!-- 第二次使用缓存 -->
        <Dmsg action="sleep" sleepTime="20000"/>
        <Dmsg action="dbview"    destination="dbDemo"   username="dong" />
        <Dmsg action="queryTb"    destination="userModle"   username="dong" />
        <Dmsg action="queryByNumber"   number="3"  ifCache="true"/>    //  不通过分表键，所有表并行查询 .查询进行缓存
        <Dmsg action="queryByNumber"   number="3" ifCache="false" />    //  不通过分表键，所有表并行查询 .不缓存
        <Dmsg action="queryByNumber"   number="3"  ifCache="true"/>    //  不通过分表键，所有表并行查询 .查询进行缓存
        <Dmsg action="queryByNumber"   number="3"  ifCache="true"/>    //  不通过分表键，所有表并行查询 .查询进行缓存
        <Dmsg action="queryByNumber"   number="3" ifCache="false" />    //  不通过分表键，所有表并行查询 .不缓存
        <Dmsg action="transactionByDB"   destination="dbDemo"  names="dong777;wang999" />
        <Dmsg action="queryByTable"  username="dddd3"/>
        <Dmsg action="queryByTable"  username="yyyy5"/>
        <Dmsg action="clearTb"    destination="dbDemo"    />
        <msg action="testMapInDB"    destination="dbDemo"    />  // 测试 map 存储在数据库里
    </startMsg>
</appConfig>