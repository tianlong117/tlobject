<?xml version="1.0" encoding="UTF-8"?>
<moduleConfig>
    <params>
        <verison value="1"/>
        <package value="cn.tianlong.java.demo.chatroom.server"/>
        <!-- Login handled via direct dispatch (not pool) so return value goes back to client -->
        <msgidInPool value="logout" />
    </params>
    <modulesParams>
        <module name="reUsedSingleThreadPoolGroup"
                initModuleNumbs="50"
                maxModuleNumbs="200"
                waitPoolTime="5000"
                maxWait="10000"/>
    </modulesParams>
    <msgTable>
        <!-- App-level login handled by chatRoomServer -->
        <msgid value="login">
            <msg destination="chatRoomServer" action="login" msgTableUseType="useMsg" />
        </msgid>
        <msgid value="logout">
            <msg destination="userManagerModule" action="logout" msgTableUseType="useMsg" />
        </msgid>
        <!-- Post-connection chat messages routed to our chat room server -->
        <msgid value="send">
            <msg destination="chatRoomServer" action="send" msgTableUseType="useMsg" />
        </msgid>
        <msgid value="listUsers">
            <msg destination="chatRoomServer" action="listUsers" msgTableUseType="useMsg" />
        </msgid>
    </msgTable>
    <startMsg>
        <msg action="#getModuleByModule" moduleName="reUsedSingleThreadPoolGroup" usePreReturnMsg="false" />
    </startMsg>
</moduleConfig>
