<?xml version="1.0" encoding="UTF-8" ?>
<moduleConfig>
    <params>
        <verison value="1"/>
        <package value="cn.tianlong.java.demo.chatroom.server"/>
    </params>
    <commonParams>
        <ifLog value="true"/>
        <loglevel value="info"/>
    </commonParams>

    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.modules_config.xml" includeUnit="modules"/>
    <include file="CLASSPATH/conf/tlobject/cn.tianlong.tlobject.network_config.xml" includeUnit="modules"/>

    <modules>
        <!-- Chat log module (beforeMsgTable hook) -->
        <module name="chatLog" classfile="cn.tianlong.java.demo.chatroom.server.ChatLogModule"
                configfile="chatLog_config.xml" />
        <!-- Chat room server module -->
        <module name="chatRoomServer" classfile="cn.tianlong.java.demo.chatroom.server.ChatRoomServerModule"
                configfile="chatRoomServer_config.xml" />
        <!-- WebSocket server -->
        <module name="clientSocketServer" proxyModule="webSocketServer"
                serverName="chatRoomServer" port="9082" hostname="0.0.0.0"
                clientMsgHandler="clientMsgHandler" />
    </modules>

    <modulesParams>
        <module name="clientSocketServer">
            <params>
                <clientIdleTime value="60000"/>
            </params>
        </module>
        <!-- Configure the built-in userManagerModule for WebSocket connection management -->

        <module name="userManagerModule"   userType="anonymous"
                serverModuleName="clientSocketServer"
                msgBroadCast ="msgBroadCast" />
    </modulesParams>

    <module name="clientMsgHandler" configfile="clientMsgHandler_config.xml" lazyLoading="false" />

    <factoryBoot>
        <msg action="getModule" moduleName="logThreadPool" usePreReturnMsg="false" />
        <msg action="getModule" moduleName="msgBroadCast" usePreReturnMsg="false" />
        <msg action="getModule" moduleName="chatLog" usePreReturnMsg="false" />
        <msg action="getModule" moduleName="chatRoomServer" usePreReturnMsg="false" />
        <msg destination="clientSocketServer" action="run" waitFlag="false" usePreReturnMsg="false"/>
    </factoryBoot>
</moduleConfig>
