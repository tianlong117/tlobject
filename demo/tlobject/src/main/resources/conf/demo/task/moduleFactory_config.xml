<?xml version="1.0" encoding="UTF-8" ?>
<moduleConfig>
    <include file="CLASSPATH\conf\tlobject\cn.tianlong.tlobject.modules_config.xml" includeUnit="modules"/>
    <include file="CLASSPATH\conf\tlobject\cn.tianlong.tlobject.network_config.xml" includeUnit="modules"/>
    <params>
        <ifLog value="true"/>
        <loglevel value="debug"/>
        <package value="cn.tianlong.java.demo"/>
        <ifModuleMonitor value="false"/>
        <applicationId value="demo"/>
        <!--防止某个任务异常错误而杀死进程 ，对taskMsg异常不处理 -->
        <ifExceptionHandle value="false" />
    </params>
    <commonParams>
        <loglevel value="debug"/>
        <!--防止某个任务异常错误而杀死进程  -->
        <!--ifExceptionHandle value="false" /-->
    </commonParams>
    <modules>
        <!-- 自定义模块 -->
        <module name="pcboy" classfile=".task.PcBoy"  />
        <module name="pcboy1" proxyModule="pcboy"  />
        <module name="pcboy2" proxyModule="pcboy"  />
        <module name="light" classfile="cn.tianlong.java.demo.base.Light" />
        <module name="myTaskManger" proxyModule="msgTask" configfile="msgtask_config.xml" />
        <module name="mymsgTaskConsole" proxyModule="msgTaskConsole" configfile="mymsgTaskConsole_config.xml" />

    </modules>
    <factoryBoot>
        <msg action="getModule"  moduleName="pcboy1" usePreReturnMsg="false" />
        <msg action="getModule"  moduleName="pcboy2" usePreReturnMsg="false" />
        <msg action="getModule"  moduleName="myTaskManger" usePreReturnMsg="false" />
        <msg action="startScan"  destination="mymsgTaskConsole" usePreReturnMsg="false" />
    </factoryBoot>
</moduleConfig>