<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
  <servlet>
    <servlet-name>student</servlet-name>
    <servlet-class>com.maven.servlet.Student</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>student</servlet-name>
    <url-pattern>/student</url-pattern>
  </servlet-mapping>
<listener>
  <!--指定监听器实现类的全限定名-->
  <listener-class>cn.tianlong.tlobject.servletutils.application.OnlineListener</listener-class>
</listener>

<filter>
  <filter-name>demofilter</filter-name>
  <filter-class>cn.tianlong.tlobject.servletutils.TLFilterWithSingleFactory</filter-class>
  <init-param>
    <param-name>configPath</param-name>
    <param-value>democonf</param-value>
  </init-param>
  <init-param>
    <param-name>initialCapacity</param-name>
    <param-value>300</param-value>
  </init-param>
  <init-param>
    <param-name>configFileOfFactory</param-name>
    <param-value>moduleFactory_config.xml</param-value>
  </init-param>
  <init-param>
    <param-name>startup</param-name>
    <param-value>yes</param-value>
  </init-param>
</filter>
<filter-mapping>
  <filter-name>demofilter</filter-name>
  <url-pattern>/demo/*</url-pattern>
</filter-mapping>

</web-app>
