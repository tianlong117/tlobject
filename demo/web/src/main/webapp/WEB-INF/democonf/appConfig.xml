<?xml version="1.0" encoding="UTF-8" ?>
<appConfig>
    <params>
        <name    value="demo"/>
        <verison value="1"/>
        <charset value="UTF-8"/>
        <!-- 框架url路径  与过滤器中配置一致-->
        <tlobjectPath value="/demo"/>
        <!-- 默认用户类 -->
        <defaultClientUser value="webUser" />
    </params>
    <!-- 消息路由表-->
    <msgTable>
        <msgid  value="setup" >
            <msg action="getModule" destination="moduleFactory" moduleName="volecity"/>
        </msgid>
    </msgTable>
    <!-- 初始运行消息表-->
    <initMsg>
        <!-- 启动日志，根据msgtable 动态加入监听对象-->
        <!--msg action="startLogOnRun" destination="msglog" useInputMsg="false" usePreReturnMsg="false"/ -->

</initMsg>
    <!-- 方法运行前执行消息表-->

    <beforeMsgTable>
        <action  value="start" >
            <msg   action="setup" destination="website"  ></msg>
        </action>
        <!-- 单独方法认证
        <action  value="getuser" >
            <msg   action="authInModule" destination="webauth" />
        </action>
        -->
    </beforeMsgTable>
    <!-- 方法运行后执行消息表
   <afterMsgTable>
       <action  value="baidu1" >
           <msg   action="startLog" destination="log" waitFlag="false"/>
       </action>
   </afterMsgTable>
   -->

</appConfig>