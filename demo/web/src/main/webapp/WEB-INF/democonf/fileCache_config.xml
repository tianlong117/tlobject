<?xml version="1.0" encoding="UTF-8" ?>
<moduleConfig>
   <params>
       <!--
        cachePath:缓存文件路径。
        -->
       <cachePath value="data/demofilecache" />
       <!--
         缓存文件锁数量。为平衡缓存文件及锁的数量，多个文件共用一把锁。
         根据缓存文件的数量适当配置相应锁的数量
       -->
       <fileLockNumber value="100" />
   </params>
     <!--
      缓存项列表。
      name：缓存名称
      exptime：过期时间，单位为分钟
     -->
    <caches>
        <cacheName name="queryByName"  exptime="1"/>
    </caches>
</moduleConfig>