<?xml version="1.0" encoding="UTF-8" ?>
<params>
    <cacheClass value="fileCache" />
</params>
<moduleConfig>
       <modulesForCache>
        <module  name="homepage1" index="homepage.index"/>
        <module  name="informationModule" getReply="informationModule" replyInformation="informationModule"/>
    </modulesForCache>
    <caches>
        <cache name="homepage.index" cacheKey="index" cacheValueName="content" valueType="string"
               exptime="180" />
        <cache name="informationModule" cacheKey="getReply" cacheValueName="result" valueType="arraylist"
               exptime="180" cacheKeyVar="userid;infoid;limitstart" />
    </caches>

</moduleConfig>